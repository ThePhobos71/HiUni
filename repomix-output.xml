                            .height(cardHeight)
                    ) {
                        Box {
                            // Hi-Res TMDB-Poster als Background
                            if (hasPoster) {
                                AsyncImage(
                                    model = movie.posterUrl,
                                    contentDescription = movie.title,
                                    modifier = Modifier.fillMaxSize(),
                                    contentScale = ContentScale.Crop
                                )
                                // Gradient-Overlay damit Titel unten lesbar bleibt
                                Box(
                                    modifier = Modifier
