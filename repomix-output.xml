                                                    scrim.copy(alpha = 0.85f)
                                                )
                                            )
                                        )
                                )
                            }
                            // Dekorativer Kreis oben rechts (nur ohne Poster, Mock-Look)
                            if (!hasPoster) {
                                Box(
                                    modifier = Modifier
                                        .align(Alignment.TopEnd)
