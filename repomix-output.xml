            modifier = Modifier.weight(1f)
        )
        Text(
            text = value,
            style = MaterialTheme.typography.bodyMedium,
            color = colors.onSurface,
            fontWeight = FontWeight.ExtraBold
        )
    }
}

private fun formatDurationMin(mins: Int): String {
    val h = mins / 60
    val m = mins % 60
    return buildString {
        if (h > 0) append("${h}h")
        if (m > 0) {
            if (h > 0) append(' ')
            append("$m Min")
        }
        if (isEmpty()) append("0 Min")
    }
}

