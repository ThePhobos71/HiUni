<!--
  HiUni-Default-Foreground: Mortarboard (Doktorhut) — Diamant-Form als oberer
  Brett-Teil, abgesetzter Cap-Trapez darunter, kleiner Knopf oben + Quaste.
  Default + Dark nutzen dieses Foreground in Weiß.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Mortarboard (Diamant-Form, perspektivisch) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,24 L94,46 L54,68 L14,46 Z" />
    <!-- Cap (Trapezoid mit rounded Bottom) — gerundet um Hut-Form anzudeuten -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,60 L78,60 L82,80 Q54,90 26,80 Z" />
    <!-- Knopf oben am Mortarboard -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,18 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
    <!-- Quaste: Schnur vom Knopf nach unten rechts + kleines Fransen-Ende -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M55,22 L57,22 L84,44 L82,46 Z" />
    <!-- Quasten-Ende (kleiner Tropfen) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M82,46 L88,52 L84,60 L80,58 L78,52 Z" />
</vector>
