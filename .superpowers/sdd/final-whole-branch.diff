--- /dev/null
+++ b/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/Application.kt
@@ -0,0 +1,63 @@
+package de.transio.hiuni.relay
+
+import io.ktor.serialization.kotlinx.json.json
+import io.ktor.server.application.install
+import io.ktor.server.engine.embeddedServer
+import io.ktor.server.netty.Netty
+import io.ktor.server.plugins.contentnegotiation.ContentNegotiation
+import io.ktor.server.routing.routing
+import io.ktor.server.websocket.WebSockets
+import org.slf4j.LoggerFactory
+import kotlin.system.exitProcess
+
+fun main() {
+    val logger = LoggerFactory.getLogger("Application")
+    val dbPath = System.getenv("DB_PATH") ?: "relay.db"
+    val store = EventStore(dbPath).also { it.init() }
+
+    val hmacSecret = System.getenv("HMAC_SECRET").orEmpty()
+    val masterKeyB64 = System.getenv("MASTER_KEY_B64").orEmpty()
+
+    if (hmacSecret.isBlank()) {
+        // Task 19: HMAC_SECRET ist Pflicht — ohne können wir Matrikelnummern nicht
+        // pseudonymisieren und damit nicht zwischen Phone-Wechseln und Spoofing
+        // unterscheiden. Fail-fast statt stillem Datenleck.
+        logger.error("HMAC_SECRET is empty — required for /validate (LSF Matrikel-Hash). Refusing to start.")
+        exitProcess(78) // EX_CONFIG
+    }
+    if (masterKeyB64.isBlank()) {
+        logger.warn("MASTER_KEY_B64 is empty — generating fresh Ed25519 keypair and persisting to /data/master.key")
+    }
+
+    val masterKey = MasterKey(envB64 = masterKeyB64.ifBlank { null })
+    // I2-Fix: LSF_BRIDGE ist ENV-getoggelt. Default = fail-fast — wir wollen
+    // niemals stillschweigend in den Dev-Stub fallen, sobald ein echter Bridge
+    // existiert. Explizites `LSF_BRIDGE=stub` ist die Opt-in-Geste.
+    val lsfBridgeKind = System.getenv("LSF_BRIDGE")
+    val lsf: LsfBridge = when (lsfBridgeKind) {
+        "stub" -> {
+            logger.warn("LSF_BRIDGE=stub — accepting any cookie starting with 'stub-'. NOT for production.")
+            StubLsfBridge()
+        }
+        null, "" -> {
+            logger.error("LSF_BRIDGE not configured. Set LSF_BRIDGE=stub for dev, or wait for HiUniLsfBridge impl. Refusing to start.")
+            exitProcess(78)
+        }
+        else -> {
+            logger.error("LSF_BRIDGE=$lsfBridgeKind — unknown bridge type. Valid: stub")
+            exitProcess(78)
+        }
+    }
+    logger.info("MasterKey loaded; relay pubkey={}", masterKey.pubkeyB64)
+
+    embeddedServer(Netty, port = 8080, host = "0.0.0.0") {
+        installEventStore(store)
+        install(ContentNegotiation) { json(json) }
+        install(WebSockets)
+        routing {
+            health()
+            sync()
+            validate(masterKey, lsf, hmacSecret)
+        }
+    }.start(wait = true)
+}
diff --git a/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/EventStore.kt b/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/EventStore.kt
new file mode 100644
index 0000000..3d8bda8
--- /dev/null
+++ b/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/EventStore.kt
@@ -0,0 +1,147 @@
+package de.transio.hiuni.relay
+
+import java.sql.Connection
+import java.sql.DriverManager
+
+data class Batch(
+    val items: List<String>,
+    val hasMore: Boolean,
+    val cursor: Long,
+    val cursorId: String? = null,
+)
+
+class EventStore(private val dbPath: String) {
+    private val conn: Connection by lazy {
+        DriverManager.getConnection("jdbc:sqlite:$dbPath").apply {
+            createStatement().use { it.execute("PRAGMA journal_mode=WAL") }
+        }
+    }
+
+    fun init() = createSchema(conn)
+
+    @Synchronized
+    fun insert(eventId: String, type: String, pubkey: String, ts: Long, payload: String) {
+        conn.prepareStatement(
+            "INSERT OR IGNORE INTO events(event_id,type,pubkey,ts,payload) VALUES (?,?,?,?,?)"
+        ).use {
+            it.setString(1, eventId)
+            it.setString(2, type)
+            it.setString(3, pubkey)
+            it.setLong(4, ts)
+            it.setString(5, payload)
+            it.executeUpdate()
+        }
+    }
+
+    @Synchronized
+    fun exists(eventId: String): Boolean {
+        conn.prepareStatement("SELECT 1 FROM events WHERE event_id = ?").use {
+            it.setString(1, eventId)
+            return it.executeQuery().next()
+        }
+    }
+
+    @Synchronized
+    fun countSince(pubkey: String, sinceMs: Long): Int {
+        conn.prepareStatement("SELECT COUNT(*) FROM events WHERE pubkey = ? AND ts >= ?").use {
+            it.setString(1, pubkey)
+            it.setLong(2, sinceMs)
+            val rs = it.executeQuery()
+            rs.next()
+            return rs.getInt(1)
+        }
+    }
+
+    @Synchronized
+    fun queryAfter(sinceMs: Long, limit: Int, sinceId: String? = null): Batch {
+        val items = mutableListOf<String>()
+        var maxTs = sinceMs
+        var maxId: String? = sinceId
+        val sql = if (sinceId != null) {
+            // Composite-Cursor: ts-Kollisionen werden über event_id-Tiebreak aufgelöst.
+            "SELECT ts, event_id, payload FROM events " +
+                "WHERE ts > ? OR (ts = ? AND event_id > ?) " +
+                "ORDER BY ts ASC, event_id ASC LIMIT ?"
+        } else {
+            "SELECT ts, event_id, payload FROM events WHERE ts > ? " +
+                "ORDER BY ts ASC, event_id ASC LIMIT ?"
+        }
+        conn.prepareStatement(sql).use {
+            if (sinceId != null) {
+                it.setLong(1, sinceMs)
+                it.setLong(2, sinceMs)
+                it.setString(3, sinceId)
+                it.setInt(4, limit + 1)
+            } else {
+                it.setLong(1, sinceMs)
+                it.setInt(2, limit + 1)
+            }
+            val rs = it.executeQuery()
+            while (rs.next() && items.size < limit) {
+                items.add(rs.getString("payload"))
+                maxTs = rs.getLong("ts")
+                maxId = rs.getString("event_id")
+            }
+            val hasMore = rs.next()
+            return Batch(items, hasMore, maxTs, maxId)
+        }
+    }
+
+    @Synchronized
+    fun totalCount(): Long {
+        conn.prepareStatement("SELECT COUNT(*) FROM events").use {
+            val rs = it.executeQuery()
+            rs.next()
+            return rs.getLong(1)
+        }
+    }
+
+    @Synchronized
+    fun upsertMatNr(hash: String, pubkey: String) {
+        conn.prepareStatement(
+            """
+            INSERT INTO mat_nr_hashes(hash,pubkey,validated_at)
+            VALUES (?,?,?)
+            ON CONFLICT(hash) DO UPDATE SET pubkey=excluded.pubkey, validated_at=excluded.validated_at
+            """.trimIndent()
+        ).use {
+            it.setString(1, hash)
+            it.setString(2, pubkey)
+            it.setLong(3, System.currentTimeMillis())
+            it.executeUpdate()
+        }
+    }
+
+    @Synchronized
+    fun findMatNr(hash: String): String? {
+        conn.prepareStatement("SELECT pubkey FROM mat_nr_hashes WHERE hash = ?").use {
+            it.setString(1, hash)
+            val rs = it.executeQuery()
+            return if (rs.next()) rs.getString(1) else null
+        }
+    }
+
+    @Synchronized
+    fun deprecateOldPubkey(old: String) {
+        conn.prepareStatement("UPDATE pubkeys SET deprecated = 1 WHERE pubkey = ?").use {
+            it.setString(1, old)
+            it.executeUpdate()
+        }
+    }
+
+    @Synchronized
+    fun registerPubkey(pubkey: String, validationEventId: String) {
+        conn.prepareStatement(
+            """
+            INSERT INTO pubkeys(pubkey,validated_at,validation_event_id)
+            VALUES (?,?,?)
+            ON CONFLICT(pubkey) DO UPDATE SET validated_at=excluded.validated_at
+            """.trimIndent()
+        ).use {
+            it.setString(1, pubkey)
+            it.setLong(2, System.currentTimeMillis())
+            it.setString(3, validationEventId)
+            it.executeUpdate()
+        }
+    }
+}
diff --git a/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/Hmac.kt b/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/Hmac.kt
