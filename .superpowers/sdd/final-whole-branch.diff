+++ b/shared-events/src/main/kotlin/de/transio/hiuni/events/Backup.kt
@@ -0,0 +1,81 @@
+package de.transio.hiuni.events
+
+import java.security.SecureRandom
+import javax.crypto.Cipher
+import javax.crypto.SecretKeyFactory
+import javax.crypto.spec.GCMParameterSpec
+import javax.crypto.spec.PBEKeySpec
+import javax.crypto.spec.SecretKeySpec
+
+/**
+ * Verschlüsseltes Backup-Blob (Phase 5, Mail-Backup).
+ *
+ * - [salt] (16 Byte, base64): zufälliger PBKDF2-Salt pro Backup.
+ * - [ciphertext] (base64): 12-Byte-IV gefolgt von AES/GCM/NoPadding-Ciphertext (inkl. 128-bit Auth-Tag).
+ * - [pubkey] (base64): Ed25519-Public-Key des Backups (zur Verifikation/Anzeige).
+ * - [ts]: Erstellungszeitpunkt in epoch ms.
+ */
+data class BackupBlob(
+    val salt: String,
+    val ciphertext: String,
+    val pubkey: String,
+    val ts: Long,
+)
+
+/**
+ * AES-GCM-verschlüsseltes Backup eines Ed25519-Secret-Keys (oder beliebigen Bytes),
+ * Key abgeleitet aus User-PIN via PBKDF2-HMAC-SHA256.
+ *
+ * Default 600.000 Iterationen (siehe Spec). Tests dürfen einen kleineren Wert
+ * (z.B. 1000) übergeben, müssen aber Encrypt/Decrypt mit demselben Wert aufrufen.
+ */
+object Backup {
+    private const val PBKDF2_ALGO = "PBKDF2WithHmacSHA256"
+    private const val AES_TRANSFORM = "AES/GCM/NoPadding"
+    private const val KEY_BITS = 256
+    private const val SALT_BYTES = 16
+    private const val IV_BYTES = 12
+    private const val TAG_BITS = 128
+
+    fun encrypt(
+        secret: ByteArray,
+        pin: String,
+        pubkey: String,
+        iterations: Int = 600_000,
+    ): BackupBlob {
+        val rng = SecureRandom()
+        val salt = ByteArray(SALT_BYTES).also { rng.nextBytes(it) }
+        val iv = ByteArray(IV_BYTES).also { rng.nextBytes(it) }
+        val key = deriveKey(pin, salt, iterations)
+        val cipher = Cipher.getInstance(AES_TRANSFORM)
+        cipher.init(Cipher.ENCRYPT_MODE, SecretKeySpec(key, "AES"), GCMParameterSpec(TAG_BITS, iv))
+        val ct = cipher.doFinal(secret)
+        return BackupBlob(
+            salt = salt.toBase64(),
+            ciphertext = (iv + ct).toBase64(),
+            pubkey = pubkey,
+            ts = System.currentTimeMillis(),
+        )
+    }
+
+    fun decrypt(
+        blob: BackupBlob,
+        pin: String,
+        iterations: Int = 600_000,
+    ): ByteArray? = runCatching {
+        val salt = blob.salt.fromBase64()
+        val all = blob.ciphertext.fromBase64()
+        require(all.size > IV_BYTES) { "ciphertext too short" }
+        val iv = all.copyOfRange(0, IV_BYTES)
+        val ct = all.copyOfRange(IV_BYTES, all.size)
+        val key = deriveKey(pin, salt, iterations)
+        val cipher = Cipher.getInstance(AES_TRANSFORM)
+        cipher.init(Cipher.DECRYPT_MODE, SecretKeySpec(key, "AES"), GCMParameterSpec(TAG_BITS, iv))
+        cipher.doFinal(ct)
+    }.getOrNull()
+
+    internal fun deriveKey(pin: String, salt: ByteArray, iter: Int): ByteArray {
+        val spec = PBEKeySpec(pin.toCharArray(), salt, iter, KEY_BITS)
+        return SecretKeyFactory.getInstance(PBKDF2_ALGO).generateSecret(spec).encoded
+    }
+}
