+import de.transio.hiuni.feature.mensa.review.data.RecipeAggregate
+import java.util.Locale
+
+/**
+ * Kompakter Reviews-Badge unter Name/Preis. Im Collapsed-State eine Zeile:
+ *
+ *   ★ 4.2 (n=7) · 86% bestellen wieder                 [▾]
+ *
+ * Aufgeklappt rendert er pro Dimension (Geschmack/Portion/Preis-Leistung/Sättigung)
+ * eine Zeile mit `★ Ø (n)` und darunter den "Bewerten ▸"-Button. Der Button ruft
+ * [onBewerten] auf — der Caller navigiert dann zum [ReviewSubmitScreen].
+ */
+@Composable
+fun ReviewBadge(
+    recipeHash: String,
+    mealName: String,
+    onBewerten: () -> Unit,
+    modifier: Modifier = Modifier,
+    vm: ReviewBadgeViewModel = hiltViewModel(),
+) {
+    val agg by vm.aggregate(recipeHash).collectAsState(initial = null)
+    var expanded by remember { mutableStateOf(false) }
+
+    val semantics = HiUniColors.semantics
+    val colors = MaterialTheme.colorScheme
+
+    Surface(
+        color = semantics.surfaceAlt,
+        shape = RoundedCornerShape(HiUniRadii.card),
+        modifier = modifier.fillMaxWidth()
+    ) {
+        Column(
+            modifier = Modifier.padding(horizontal = 14.dp, vertical = 10.dp)
+        ) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text(
+                    text = formatHeadline(agg),
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = colors.onSurface,
+                    fontWeight = FontWeight.SemiBold,
+                    modifier = Modifier.weight(1f)
+                )
+                TextButton(onClick = { expanded = !expanded }) {
+                    Text(if (expanded) "▴" else "▾")
+                }
+            }
+            if (expanded) {
+                val dims = agg?.byDimension.orEmpty()
+                if (dims.isEmpty()) {
+                    Spacer(Modifier.height(2.dp))
+                    Text(
+                        text = "Noch keine Detail-Bewertungen.",
+                        style = MaterialTheme.typography.bodySmall,
+                        color = semantics.onSurfaceMuted
+                    )
+                } else {
+                    // Reihenfolge stabil halten, statt Map-Order
+                    val order = listOf(
+                        Dimension.TASTE, Dimension.PORTION,
+                        Dimension.VALUE, Dimension.SATIATION
+                    )
+                    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                        order.forEach { dim ->
+                            dims[dim]?.let { stat ->
+                                Row {
+                                    Text(
+                                        text = labelFor(dim),
+                                        style = MaterialTheme.typography.bodySmall,
+                                        color = semantics.onSurfaceMuted,
+                                        modifier = Modifier.weight(1f)
+                                    )
+                                    Text(
+                                        text = "★ %.1f  (%d)".format(
+                                            Locale.GERMAN,
+                                            stat.avg,
+                                            stat.n,
+                                        ),
+                                        style = MaterialTheme.typography.bodySmall,
+                                        color = colors.onSurface,
+                                        fontWeight = FontWeight.SemiBold
+                                    )
+                                }
+                            }
+                        }
+                    }
+                }
+                Spacer(Modifier.height(6.dp))
+                TextButton(onClick = onBewerten) {
+                    Text("Bewerten ▸", fontWeight = FontWeight.Bold)
+                }
+            }
+        }
+    }
+}
+
+private fun formatHeadline(a: RecipeAggregate?): String {
+    if (a == null || a.overallCount == 0) {
+        return "Noch keine Bewertungen — sei der erste!"
+    }
+    val overall = a.overall ?: 0f
+    val pct = a.wouldOrderAgainPct ?: 0
+    return "★ %.1f (n=%d) · %d%% bestellen wieder".format(Locale.GERMAN, overall, a.overallCount, pct)
+}
+
+private fun labelFor(d: Dimension): String = when (d) {
+    Dimension.TASTE -> "Geschmack"
+    Dimension.PORTION -> "Portion"
+    Dimension.VALUE -> "Preis-Leistung"
+    Dimension.SATIATION -> "Sättigung"
+}
