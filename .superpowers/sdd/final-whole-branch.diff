new file mode 100644
index 0000000..7a69c4a
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,33 @@
+# Repo-root .dockerignore for the :hiuni-relay build.
+#
+# docker-compose.yml uses `build.context: ../` (repo root), so the canonical
+# .dockerignore lives here. (Previously a per-Dockerfile variant existed under
+# hiuni-relay/Dockerfile.dockerignore, but BuildKit also reads this top-level
+# file when no per-Dockerfile variant is present — having only one source of
+# truth avoids drift.)
+#
+# Gradle build still needs settings.gradle.kts, root build.gradle.kts, and ALL
+# modules (incl. :shared-events) — don't add include-excludes that would drop those.
+.git
+.github
+.gradle
+.idea
+.kotlin
+*.iml
+**/build/
+local.properties
+*.apk
+*.aab
+*.log
+.DS_Store
+
+# IDE captures / native build leftovers (Android side)
+/captures
+.externalNativeBuild
+.cxx
+
+# Our own env file should never end up in the image context
+hiuni-relay/.env
+
+# Superpowers scratch / sub-agent transcripts
+.superpowers/
