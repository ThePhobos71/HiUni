index 0000000..02ab8f8
--- /dev/null
+++ b/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MailBackup.kt
@@ -0,0 +1,216 @@
+package de.transio.hiuni.feature.mensa.review.trust
+
+import de.transio.hiuni.core.security.CredentialsManager
+import de.transio.hiuni.di.IoDispatcher
+import de.transio.hiuni.events.Backup
+import de.transio.hiuni.events.BackupBlob
+import de.transio.hiuni.events.toBase64
+import jakarta.mail.Flags
+import jakarta.mail.Folder
+import jakarta.mail.Message
+import jakarta.mail.Session
+import jakarta.mail.search.SubjectTerm
+import jakarta.mail.internet.MimeMessage
+import jakarta.mail.internet.InternetAddress
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.withContext
+import org.eclipse.angus.mail.imap.IMAPFolder
+import timber.log.Timber
+import java.util.Date
+import java.util.Properties
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Backup des Ed25519-Privat-Schlüssels im eigenen IMAP-Drafts-Folder, verschlüsselt
+ * mit einer 6-stelligen Backup-PIN (AES-GCM + PBKDF2, siehe [Backup]).
+ *
+ * Wire-Format der Backup-Mail (Subject `HIUNI-KEY-BACKUP-v1`, Body 5 Zeilen):
+ *
+ *   HIUNI-KEY-BACKUP-v1
+ *   salt: <base64>
+ *   ciphertext: <base64, IV+GCM>
+ *   pubkey: <base64>
+ *   ts: <epoch-ms>
+ *
+ * Idempotent: [ensureBackup] löscht alle alten Drafts mit demselben Subject vor dem
+ * Anlegen eines neuen, damit nie zwei Backups konkurrieren. [findBackup] nimmt das
+ * jüngste Match. [restoreFromBackup] dekryptiert und ruft [MyKeyManager.restore].
+ *
+ * Nutzt das gleiche IMAPS-Pattern wie [ImapClient] — Session pro Operation, keine
+ * Connection-Pool. Drafts-Folder wird via SPECIAL-USE `\Drafts` (RFC 6154) oder
+ * Name-Match (`Drafts`, `Entwürfe`, `INBOX.Drafts`) entdeckt.
+ */
+@Singleton
+class MailBackup @Inject constructor(
+    private val credentials: CredentialsManager,
+    private val keys: MyKeyManager,
+    @IoDispatcher private val io: CoroutineDispatcher,
+) {
+
+    suspend fun ensureBackup(pin: String): Result<Unit> = withContext(io) {
+        runCatching {
+            val kp = keys.getOrNull() ?: error("kein Schlüssel vorhanden — Onboarding zuerst")
+            val blob = Backup.encrypt(
+                secret = kp.secretKey,
+                pin = pin,
+                pubkey = kp.publicKey.toBase64(),
+            )
+            val (user, password) = requireCredentials()
+            val (store, session) = openStoreAndSession(user, password)
+            try {
+                val draftsName = discoverDraftsFolder(store)
+                val folder = store.getFolder(draftsName) as IMAPFolder
+                folder.open(Folder.READ_WRITE)
+                try {
+                    // Append-first, expunge-after (data-loss-prevention):
+                    // Alte Drafts erst MARKEN, wenn der neue Draft erfolgreich
+                    // appended wurde. Sonst (z.B. network-drop nach expunge)
+                    // wäre der User backup-los.
+                    val existing = folder.search(SubjectTerm(SUBJECT))
+                    // 1. Neuen Draft anlegen
+                    val msg = MimeMessage(session).apply {
+                        subject = SUBJECT
+                        setFrom(InternetAddress(user))
+                        addRecipient(Message.RecipientType.TO, InternetAddress(user))
+                        sentDate = Date()
+                        setText(formatBody(blob), "UTF-8")
+                        flags.add(Flags.Flag.DRAFT)
+                    }
+                    folder.appendMessages(arrayOf(msg))
+                    Timber.i("MailBackup ensureBackup: Draft in '$draftsName' angelegt")
+                    // 2. ERST nach erfolgreichem append: alte Drafts entfernen.
+                    //    findBackup() nimmt via maxByOrNull(receivedDate) den
+                    //    neuen — transienter Doppelzustand ist also safe.
+                    if (existing.isNotEmpty()) {
+                        Timber.i("MailBackup ensureBackup: lösche ${existing.size} alte Drafts (nach append)")
+                        existing.forEach { it.setFlag(Flags.Flag.DELETED, true) }
+                        folder.expunge()
+                    }
+                } finally {
+                    folder.close(false)
+                }
+            } finally {
+                store.close()
+            }
+        }
+    }
+
+    suspend fun findBackup(): BackupBlob? = withContext(io) {
+        runCatching {
+            val (user, password) = requireCredentials()
+            val (store, _) = openStoreAndSession(user, password)
+            try {
+                val draftsName = discoverDraftsFolder(store)
+                val folder = store.getFolder(draftsName) as IMAPFolder
+                folder.open(Folder.READ_ONLY)
+                try {
+                    val matches = folder.search(SubjectTerm(SUBJECT))
+                    if (matches.isEmpty()) {
+                        Timber.d("MailBackup findBackup: keine Drafts mit Subject '$SUBJECT'")
+                        return@runCatching null
+                    }
+                    // Jüngste zuerst
+                    val latest = matches.maxByOrNull { it.receivedDate?.time ?: it.sentDate?.time ?: 0L }
+                        ?: matches.first()
+                    val body = (latest.content as? String)
+                        ?: (latest.content as? jakarta.mail.Multipart)
+                            ?.takeIf { it.count > 0 }
+                            ?.getBodyPart(0)?.content as? String
+                        ?: return@runCatching null
+                    parseBody(body)
+                } finally {
+                    folder.close(false)
+                }
+            } finally {
+                store.close()
+            }
+        }.onFailure { Timber.w(it, "MailBackup findBackup fehlgeschlagen") }.getOrNull()
+    }
+
+    suspend fun restoreFromBackup(blob: BackupBlob, pin: String): Boolean = withContext(io) {
+        val secret = Backup.decrypt(blob, pin) ?: return@withContext false
+        keys.restore(pubkeyB64 = blob.pubkey, secretBytes = secret)
+        Timber.i("MailBackup restoreFromBackup: Pubkey wiederhergestellt (${blob.pubkey.take(8)}…)")
+        true
+    }
+
+    // ─── Internals ────────────────────────────────────────────────────────────
+
+    private fun requireCredentials(): Pair<String, String> {
+        val user = credentials.getUsername()
+            ?: error("Kein IMAP-Username hinterlegt — Mail-Login erforderlich")
+        val password = credentials.getPassword()
+            ?: error("Kein IMAP-Passwort hinterlegt — Mail-Login erforderlich")
+        return user to password
+    }
+
+    private fun openStoreAndSession(user: String, password: String): Pair<jakarta.mail.Store, Session> {
+        val props = Properties().apply {
+            put("mail.store.protocol", "imaps")
+            put("mail.imaps.host", IMAP_HOST)
+            put("mail.imaps.port", IMAP_PORT.toString())
+            put("mail.imaps.ssl.enable", "true")
+            put("mail.imaps.ssl.checkserveridentity", "true")
+            put("mail.imaps.connectiontimeout", "15000")
+            put("mail.imaps.timeout", "20000")
+            put("mail.mime.charset", "UTF-8")
+        }
+        val session = Session.getInstance(props)
+        val store = session.getStore("imaps")
+        store.connect(IMAP_HOST, IMAP_PORT, user, password)
+        return store to session
+    }
+
+    /** SPECIAL-USE `\Drafts` (RFC 6154), Fallback auf Name-Match. */
+    private fun discoverDraftsFolder(store: jakarta.mail.Store): String {
+        val folders = store.defaultFolder.list("*")
+        // 1. SPECIAL-USE
+        val viaFlag = folders.firstOrNull { f ->
+            val attrs = (f as? IMAPFolder)?.attributes.orEmpty()
+            attrs.any { it.equals("\\Drafts", ignoreCase = true) }
+        }
+        if (viaFlag != null) return viaFlag.fullName
+        // 2. Name-Match (häufige Server-Konventionen)
+        val candidates = listOf("Drafts", "Entwürfe", "INBOX.Drafts", "INBOX.Entwürfe", "[Gmail]/Drafts")
+        candidates.forEach { name ->
+            val match = folders.firstOrNull { it.fullName.equals(name, ignoreCase = true) }
+            if (match != null) return match.fullName
+        }
+        // 3. Fallback — die meisten Server akzeptieren das wenigstens als Alias
+        Timber.w("MailBackup discoverDraftsFolder: kein Drafts-Folder gefunden, fallback 'Drafts'")
+        return "Drafts"
+    }
+
+    private fun formatBody(blob: BackupBlob): String = buildString {
+        appendLine("HIUNI-KEY-BACKUP-v1")
+        appendLine("salt: ${blob.salt}")
+        appendLine("ciphertext: ${blob.ciphertext}")
+        appendLine("pubkey: ${blob.pubkey}")
+        appendLine("ts: ${blob.ts}")
+    }
+
+    private fun parseBody(body: String): BackupBlob? {
+        val map = body.lines()
+            .mapNotNull { line ->
+                val idx = line.indexOf(':')
+                if (idx <= 0) return@mapNotNull null
+                val key = line.substring(0, idx).trim()
+                val value = line.substring(idx + 1).trim()
+                if (key.isEmpty() || value.isEmpty()) null else key to value
+            }
+            .toMap()
+        return BackupBlob(
+            salt = map["salt"] ?: return null,
+            ciphertext = map["ciphertext"] ?: return null,
+            pubkey = map["pubkey"] ?: return null,
+            ts = map["ts"]?.toLongOrNull() ?: return null,
+        )
+    }
+
+    companion object {
+        const val SUBJECT = "HIUNI-KEY-BACKUP-v1"
+        private const val IMAP_HOST = "mail.uni-hildesheim.de"
+        private const val IMAP_PORT = 993
+    }
+}
diff --git a/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MailIntro.kt b/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MailIntro.kt
new file mode 100644
index 0000000..b386dc2
--- /dev/null
+++ b/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MailIntro.kt
@@ -0,0 +1,186 @@
+package de.transio.hiuni.feature.mensa.review.trust
+
+import de.transio.hiuni.events.AcceptResult
+import de.transio.hiuni.events.IntroEvent
+import de.transio.hiuni.feature.email.data.SmtpClient
+import de.transio.hiuni.feature.mensa.review.data.TrustDao
+import de.transio.hiuni.feature.mensa.review.data.TrustEntity
+import de.transio.hiuni.feature.mensa.review.sync.ValidatorFactory
+import timber.log.Timber
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Mail-Intro: Sender + Receiver für den E-Mail-Fallback des Web-of-Trust-Onboardings.
+ *
+ * Wire-Format der Intro-Mail (Subject `HIUNI-INTRO-v1`, Body 4 `key: value`-Zeilen,
+ * gleicher Stil wie [MailBackup]):
+ *
+ *   HIUNI-INTRO-v1
+ *   invitee: <base64-pubkey>
+ *   inviter: <base64-pubkey>
+ *   ts: <epoch-ms>
+ *   sig: <base64-sig>
+ *
+ * Sender ruft [IntroIssuer.issueIntro] auf → bekommt ein signiertes [IntroEvent] →
+ * baut die Mail → versendet über [SmtpClient]. Receiver parst eingehende Mails, validiert
+ * sie mit dem [de.transio.hiuni.events.EventValidator] und schreibt sie in [TrustDao].
+ *
+ * Beide Klassen sind bewusst entkoppelt: der periodische Scanner ([MailIntroScanner])
+ * orchestriert IMAP-Suche → parse → import.
+ */
+
+/** Subject-Konstante. EXAKT dieser String — Versionierung wichtig für Forward-Compat. */
+const val MAIL_INTRO_SUBJECT = "HIUNI-INTRO-v1"
+
+/**
+ * Sendet eine Intro-Einladung per E-Mail.
+ *
+ * Reused [IntroIssuer.issueIntro] — der enthält bereits alle Vorbedingungen
+ * (5-Intros-Limit, depth < 2, lokal-trusted) und schreibt das Event in den Outbox
+ * sowie die lokale Trust-Tabelle. Diese Klasse fügt nur den Mail-Transport hinzu.
+ */
+@Singleton
+class MailIntroSender @Inject constructor(
+    private val smtp: SmtpClient,
+    private val issuer: IntroIssuer,
+) {
+    suspend fun sendIntro(toAddress: String, inviteePubkey: String): Result<Unit> = runCatching {
+        require(toAddress.isNotBlank()) { "leere Empfänger-Adresse" }
+        val ev = issuer.issueIntro(inviteePubkey).getOrThrow()
+        val body = formatBody(ev)
+        when (val result = smtp.send(
+            to = listOf(toAddress),
+            subject = MAIL_INTRO_SUBJECT,
+            bodyPlain = body,
+        )) {
+            is SmtpClient.SendResult.Success -> {
+                Timber.i("MailIntroSender: Intro versendet to=$toAddress invitee=${inviteePubkey.take(8)}…")
+                Unit
+            }
+            is SmtpClient.SendResult.Failure -> throw result.error
+        }
+    }
+
+    private fun formatBody(ev: IntroEvent): String = buildString {
+        appendLine(MAIL_INTRO_SUBJECT)
+        appendLine("invitee: ${ev.invitee}")
+        appendLine("inviter: ${ev.inviter}")
+        appendLine("ts: ${ev.ts}")
+        appendLine("sig: ${ev.sig}")
+    }
+}
+
+/**
+ * Importiert eingehende Intro-Events aus geparsten Mail-Bodies in die lokale Trust-Tabelle.
+ *
+ * Reihenfolge der Prüfungen — wichtig, damit [ImportResult] präzise ist:
+ * 1. Signatur via [ValidatorFactory] (validiert Sig + depth-Resolver + Spam-Limit).
+ * 2. Inviter ist in der lokalen `trust`-Tabelle (sonst können wir kein `depth + 1` rechnen).
+ * 3. Depth ≤ 2 (sonst würden Folge-Intros die Trust-Tiefe sprengen).
+ * 4. Idempotenz: wenn `invitee` schon getrusted ist, kein Update — alter Eintrag bleibt.
+ */
+class MailIntroReceiver @Inject constructor(
+    private val trustDao: TrustDao,
+    private val validatorFactory: ValidatorFactory,
+) {
+
+    fun parse(body: String): IntroEvent? {
+        // Erste Zeile MUSS exakt das Subject-Magic sein, sonst ist es keine v1-Intro-Mail.
+        // Schützt vor false-positives wenn der Subject-Filter mal aus Versehen normale
+        // Mails durchlässt (z.B. RE: HIUNI-INTRO-v1 ohne Body-Header).
+        val lines = body.lines()
+        if (lines.firstOrNull()?.trim() != MAIL_INTRO_SUBJECT) {
+            Timber.d("MailIntroReceiver.parse: erste Zeile != Magic, skip")
+            return null
+        }
+        val map = lines.drop(1)
+            .mapNotNull { line ->
+                val idx = line.indexOf(':')
+                if (idx <= 0) return@mapNotNull null
+                val key = line.substring(0, idx).trim()
+                val value = line.substring(idx + 1).trim()
+                if (key.isEmpty() || value.isEmpty()) null else key to value
+            }
+            .toMap()
+        val invitee = map["invitee"] ?: return null
+        val inviter = map["inviter"] ?: return null
+        val ts = map["ts"]?.toLongOrNull() ?: return null
+        val sig = map["sig"] ?: return null
+        return IntroEvent(invitee = invitee, inviter = inviter, ts = ts, sig = sig)
+    }
+
+    suspend fun import(event: IntroEvent): ImportResult {
+        // 1. Validator — prüft Sig (mit inviter-Pubkey), Spam-Limit, Trust-Resolver.
+        //    `AcceptResult.Reject` mit reason "invalid signature" → BadSignature;
+        //    "pubkey not trusted" → InviterNotTrusted (Validator nutzt e.pubkey,
+        //    und für IntroEvent ist `pubkey = inviter`).
+        val validator = validatorFactory.create()
+        val verdict = validator.accept(event)
+        if (verdict is AcceptResult.Reject) {
+            Timber.i("MailIntroReceiver.import: rejected reason=${verdict.reason}")
+            return when {
+                verdict.reason.contains("signature", ignoreCase = true) -> ImportResult.BadSignature
+                verdict.reason.contains("not trusted", ignoreCase = true) -> ImportResult.InviterNotTrusted
+                else -> ImportResult.BadSignature // Konservativ — alle anderen Reject-Reasons als bad sig
+            }
+        }
+
+        // 2. Inviter muss lokal getrusted sein, damit wir die depth + 1 ableiten können.
+        //    Doppelte Prüfung neben dem Validator-Trust-Resolver, weil der Validator
+        //    sich potentiell nur auf Cache verlässt — hier wollen wir den DAO-Wert direkt.
+        val inviterRow = trustDao.find(event.inviter)
+            ?: return ImportResult.InviterNotTrusted.also {
+                Timber.w("MailIntroReceiver.import: inviter ${event.inviter.take(8)}… nicht lokal getrusted")
+            }
+
+        // 3. Depth-Check: depth_invitee = depth_inviter + 1, max erlaubt = 2.
+        val newDepth = inviterRow.depth + 1
+        if (newDepth > 2) {
+            Timber.w("MailIntroReceiver.import: depthTooDeep — inviter=${inviterRow.depth}, newDepth=$newDepth")
+            return ImportResult.DepthTooDeep
+        }
+
+        // 4. Idempotenz — wenn invitee schon getrusted ist (z.B. via QR-Intro oder
+        //    früheres Mail-Import), kein Doppel-Insert. Sonst würde der OnConflict.REPLACE
+        //    den source/depth potentiell überschreiben.
+        val existing = trustDao.find(event.invitee)
+        if (existing != null) {
+            Timber.i("MailIntroReceiver.import: invitee ${event.invitee.take(8)}… bereits getrusted (depth=${existing.depth})")
+            return ImportResult.AlreadyTrusted
+        }
+
+        trustDao.insert(
+            TrustEntity(
+                pubkey = event.invitee,
+                source = event.inviter,
+                depth = newDepth,
+                ts = event.ts,
+                sig = event.sig,
+            )
+        )
+        Timber.i("MailIntroReceiver.import: ok invitee=${event.invitee.take(8)}… depth=$newDepth")
+        return ImportResult.Ok
+    }
+}
+
+/**
+ * Ergebnis eines [MailIntroReceiver.import]-Aufrufs.
+ *
+ * Bewusst granular — das ruft der Scanner per Log, und ein UI-Layer könnte später
+ * unterschiedliche Toasts/Banners darstellen.
+ */
+enum class ImportResult {
+    /** Trust-Eintrag wurde eingefügt. */
+    Ok,
+    /** Signatur passt nicht zum inviter-Pubkey (oder andere Validator-Rejection). */
+    BadSignature,
+    /** Der inviter ist auf diesem Gerät nicht (mehr) als getrusted bekannt. */
+    InviterNotTrusted,
+    /** depth_inviter + 1 > 2 — würde die Trust-Tiefe sprengen. */
+    DepthTooDeep,
+    /** invitee ist bereits in der Trust-Tabelle. */
+    AlreadyTrusted,
+    /** Body konnte nicht in ein IntroEvent geparst werden. */
+    ParseError,
+}
diff --git a/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MailIntroScanner.kt b/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MailIntroScanner.kt
