+package de.transio.hiuni.feature.mensa.review.ui
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import dagger.hilt.android.lifecycle.HiltViewModel
+import de.transio.hiuni.feature.mensa.review.trust.IntroIssuer
+import de.transio.hiuni.feature.mensa.review.trust.MyKeyManager
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import java.util.Base64
+import javax.inject.Inject
+
+/**
+ * UI-State für den QR-Intro-Screen (Task 32). Trennt drei Achsen:
+ *  - [ownPubkey]: eigener Base64-Pubkey aus [MyKeyManager], `null` solange noch
+ *    kein Onboarding (Tab "Mein QR" rendert dann einen Hinweis statt eines QR).
+ *  - [issuance]: Status des letzten Intro-Aufrufs. Idle → Submitting → Success/Error.
+ */
+data class QrIntroUi(
+    val ownPubkey: String? = null,
+    val issuance: IntroState = IntroState.Idle,
+)
+
+sealed class IntroState {
+    object Idle : IntroState()
+    object Submitting : IntroState()
+    data class Success(val invitee: String) : IntroState()
+    data class Error(val msg: String) : IntroState()
+}
+
+@HiltViewModel
+class QrIntroViewModel @Inject constructor(
+    private val keys: MyKeyManager,
+    private val introIssuer: IntroIssuer,
+) : ViewModel() {
+
+    private val _ui = MutableStateFlow(QrIntroUi())
+    val ui = _ui.asStateFlow()
+
+    init {
+        viewModelScope.launch {
+            val kp = keys.getOrNull()
+            val pub = kp?.let { Base64.getEncoder().encodeToString(it.publicKey) }
+            _ui.value = _ui.value.copy(ownPubkey = pub)
+        }
+    }
+
+    /**
+     * Ruft [IntroIssuer.issueIntro] für den gerade gescannten Pubkey auf.
+     * IntroIssuer prüft Preconditions (eigener Key, Validierungs-Eintrag,
+     * Depth < 2, Invite-Limit) und legt bei Erfolg das IntroEvent in der
+     * Outbox + lokalen Trust-Tabelle ab.
+     */
+    fun introduce(scannedPubkey: String) {
+        if (scannedPubkey.isBlank()) return
+        viewModelScope.launch {
+            _ui.value = _ui.value.copy(issuance = IntroState.Submitting)
+            val newState = introIssuer.issueIntro(scannedPubkey)
+                .fold(
+                    onSuccess = { IntroState.Success(scannedPubkey) },
+                    onFailure = { IntroState.Error(it.message ?: "Einführen fehlgeschlagen") },
+                )
+            _ui.value = _ui.value.copy(issuance = newState)
+        }
+    }
+
+    /** Reset nach Anzeige eines Toasts/Snackbars, damit ein Folge-Scan wieder
+     *  Idle startet. */
+    fun consumeIssuance() {
+        _ui.value = _ui.value.copy(issuance = IntroState.Idle)
+    }
+}
