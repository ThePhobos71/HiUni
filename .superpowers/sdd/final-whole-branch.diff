+package de.transio.hiuni.feature.mensa.review.ui
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import dagger.hilt.android.lifecycle.HiltViewModel
+import de.transio.hiuni.core.auth.CasSession
+import de.transio.hiuni.core.auth.CasState
+import de.transio.hiuni.core.common.AuthRequiredException
+import de.transio.hiuni.events.BackupBlob
+import de.transio.hiuni.feature.mensa.review.data.ReviewRepository
+import de.transio.hiuni.feature.mensa.review.sync.MasterPubkeyProvider
+import de.transio.hiuni.feature.mensa.review.sync.RelayClient
+import de.transio.hiuni.feature.mensa.review.trust.LsfOnboarding
+import de.transio.hiuni.feature.mensa.review.trust.MailBackup
+import de.transio.hiuni.feature.mensa.review.trust.MasterPubkeyMissingException
+import de.transio.hiuni.feature.mensa.review.trust.MyKeyManager
+import de.transio.hiuni.feature.mensa.review.trust.WrongPinException
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import timber.log.Timber
+import javax.inject.Inject
+
+data class ReviewDraft(
+    val overall: Int = 0,
+    val wouldOrderAgain: Boolean? = null,
+    val taste: Int? = null,
+    val portion: Int? = null,
+    val value: Int? = null,
+    val satiation: Int? = null,
+)
+
+sealed class SubmitState {
+    object Idle : SubmitState()
+    object Submitting : SubmitState()
+    object Done : SubmitState()
+    data class Error(val msg: String) : SubmitState()
+}
+
+/**
+ * Vor-dem-Submit-Gate: solange wir keinen lokalen Keypair haben (= noch nie
+ * onboardet) ODER keine CAS-Session (= keine LSF-Identität, gegen die wir
+ * onboarden könnten), darf der User nicht submitten. Die UI rendert den
+ * passenden Login-/Onboarding-Prompt.
+ *
+ * Zustände:
+ *  - [Ready]: Keypair + Master-Pubkey vorhanden → submit erlaubt.
+ *  - [NeedsLsfLogin]: kein Keypair, KEIN CAS-Login → User muss zuerst LSF-Login.
+ *  - [NeedsRecoveryPin]: Mail-Backup auf diesem Gerät gefunden → PIN-Prompt für
+ *    Recovery (bevor wir LSF-Roundtrip starten). Enthält das Blob für Restore +
+ *    Restversuche-Zähler. Nach 3 Fehlversuchen kann der User in den Hard-Reset
+ *    (frisches Onboarding) wechseln.
+ *  - [NeedsOnboarding]: CAS okay, kein Backup (oder Recovery abgebrochen) → wir
+ *    können direkt onboarden, sobald der User es triggert.
+ *  - [NeedsBackupPin]: Onboarding erfolgreich, aber noch kein Mail-Backup hinterlegt →
+ *    optionaler PIN-Prompt für Backup-Setup (Skip ist erlaubt).
+ */
+sealed class GateState {
+    object Ready : GateState()
+    object NeedsLsfLogin : GateState()
+    data class NeedsRecoveryPin(
+        val blob: BackupBlob,
+        val attemptsLeft: Int = 3,
+        val error: String? = null,
+    ) : GateState()
+    object NeedsOnboarding : GateState()
+    object Onboarding : GateState()
+    data class OnboardingError(val msg: String) : GateState()
+    object NeedsBackupPin : GateState()
+}
+
+@HiltViewModel
+class ReviewViewModel @Inject constructor(
+    private val repo: ReviewRepository,
+    private val keys: MyKeyManager,
+    private val onboarding: LsfOnboarding,
+    private val casSession: CasSession,
+    private val mailBackup: MailBackup,
+    private val masterPubkeyProvider: MasterPubkeyProvider,
+    private val relayClient: RelayClient,
+) : ViewModel() {
+    private val _state = MutableStateFlow<SubmitState>(SubmitState.Idle)
+    val state = _state.asStateFlow()
+
+    // Fail-closed: initial Onboarding (rendert "Onboarding läuft …" placeholder),
+    // damit der Submit-Button NICHT während des initialen IMAP-Probes (1-2s
+    // via refreshGate → tryMailBackupOrNull) fälschlich enabled ist.
+    private val _gate = MutableStateFlow<GateState>(GateState.Onboarding)
+    val gate = _gate.asStateFlow()
+
+    init {
+        viewModelScope.launch { refreshGate() }
+    }
+
+    private suspend fun refreshGate() {
+        val hasKey = keys.getOrNull() != null
+        val hasMaster = masterPubkeyProvider.get().isNotBlank()
+        if (hasKey && hasMaster) {
+            _gate.value = GateState.Ready
+            return
+        }
+        val authenticated = casSession.state.value is CasState.Authenticated
+        if (!authenticated) {
+            _gate.value = GateState.NeedsLsfLogin
+            return
+        }
+        // Authenticated, aber Key/Master fehlt: probe Mail-Backup BEVOR wir den
+        // User in den LSF-Roundtrip schicken (spart einen Validate-Hit + erhält
+        // Identität auf zweitem Gerät).
+        val backup = onboarding.tryMailBackupOrNull()
+        _gate.value = if (backup != null) {
+            GateState.NeedsRecoveryPin(blob = backup, attemptsLeft = 3)
+        } else {
+            GateState.NeedsOnboarding
+        }
+    }
+
+    /**
+     * Triggert das Relay-Onboarding mit der aktuell vorhandenen CAS-Session.
+     * Erfolgsfall → wenn noch kein Mail-Backup existiert, transitionen wir nach
+     * [GateState.NeedsBackupPin] (Backup-Setup-Prompt). Andernfalls direkt Ready.
+     */
+    fun startOnboarding() {
+        viewModelScope.launch {
+            _gate.value = GateState.Onboarding
+            onboarding.startOnboarding()
+                .onSuccess { transitionAfterOnboarding() }
+                .onFailure { _gate.value = mapOnboardingFailure(it) }
+        }
+    }
+
+    /**
+     * Wird vom UI gerufen nachdem ein expliziter LSF-Login-Result-Callback
+     * mit einem bekannten Session-Cookie zurückkam. Im aktuellen Flow läuft
+     * das normalerweise über CAS — diese Methode bleibt als Test-/Debug-Hook
+     * für direkte Cookie-Einspeisung erhalten.
+     */
+    fun onLsfLoginSuccess(cookie: String) {
+        viewModelScope.launch {
+            _gate.value = GateState.Onboarding
+            onboarding.startOnboarding(cookie)
+                .onSuccess { transitionAfterOnboarding() }
+                .onFailure { _gate.value = mapOnboardingFailure(it) }
+        }
+    }
+
+    /**
+     * Recovery-Versuch mit der vom User eingegebenen PIN. Bei Erfolg starten wir
+     * den RelayClient (idempotent) und gehen direkt nach [GateState.Ready] —
+     * KEIN Backup-Setup-Prompt, weil das Backup ja schon existiert.
+     *
+     * Fehler-Pfade:
+     *  - [WrongPinException]: lokal Versuche dekrementieren, GateState mit
+     *    aktualisiertem [GateState.NeedsRecoveryPin.attemptsLeft] re-emitten.
+     *  - [MasterPubkeyMissingException]: Key restored, aber Master fehlt → User
+     *    muss LSF-Onboarding machen → [GateState.NeedsOnboarding].
+     */
+    fun tryRecover(pin: String) {
+        val current = _gate.value as? GateState.NeedsRecoveryPin ?: return
+        viewModelScope.launch {
+            onboarding.completeRecovery(current.blob, pin)
+                .onSuccess {
+                    runCatching { relayClient.start() }
+                        .onFailure { Timber.w(it, "RelayClient.start() nach Recovery fehlgeschlagen") }
+                    _gate.value = GateState.Ready
+                }
+                .onFailure { t ->
+                    when (t) {
+                        is WrongPinException -> {
+                            val left = (current.attemptsLeft - 1).coerceAtLeast(0)
+                            _gate.value = current.copy(
+                                attemptsLeft = left,
+                                error = "PIN falsch — noch $left Versuch(e)",
+                            )
+                        }
+                        is MasterPubkeyMissingException -> {
+                            _gate.value = GateState.NeedsOnboarding
+                        }
+                        else -> {
+                            _gate.value = current.copy(error = t.message ?: "Recovery fehlgeschlagen")
+                        }
+                    }
+                }
+        }
+    }
+
+    /**
+     * Hard-Reset: User gibt Recovery auf, will fresh onboarden. Wir verwerfen
+     * das Backup-Blob und schicken in [GateState.NeedsOnboarding] — der nächste
+     * `startOnboarding()`-Klick generiert einen NEUEN Keypair und überschreibt
+     * den alten DB-Eintrag.
+     */
+    fun skipRecoveryAndOnboardFresh() {
+        viewModelScope.launch {
+            // Defense: falls der Caller-Path mal von einem teils-restored
+            // Zustand kommt, alten Key wegräumen, damit LsfOnboarding.startOnboarding
+            // (das `keys.getOrNull() ?: keys.create()` macht) garantiert einen
+            // FRISCHEN Keypair erzeugt — sonst wäre "Hard-Reset (neuer Pubkey)"
+            // gelogen.
+            keys.clear()
+            _gate.value = GateState.NeedsOnboarding
+        }
+    }
+
+    /**
+     * Alternative: User will Backup vergessen, dafür Account wechseln —
+     * zurück in den LSF-Login (z.B. weil falsches Mail-Konto angemeldet war).
+     */
+    fun skipRecoveryAndStartLsfLogin() {
+        _gate.value = GateState.NeedsLsfLogin
+    }
+
+    /**
+     * Backup-Setup nach Onboarding: User gibt eine 6-stellige PIN ein, wir
+     * legen damit ein Mail-Drafts-Backup an. Erfolg → Ready. Fehler → wir
+     * loggen es, gehen aber trotzdem Ready (Backup ist optional, nicht hart
+     * erforderlich für Reviews).
+     */
+    fun setupBackup(pin: String) {
+        viewModelScope.launch {
+            mailBackup.ensureBackup(pin)
+                .onFailure { Timber.w(it, "Backup-Setup fehlgeschlagen — überspringe") }
+            _gate.value = GateState.Ready
+        }
+    }
+
+    /** User überspringt Backup-Setup (kann später nachgeholt werden). */
+    fun skipBackupSetup() {
+        _gate.value = GateState.Ready
+    }
+
+    /**
+     * Nach erfolgreichem LSF-Onboarding: prüfen, ob bereits ein Mail-Backup
+     * existiert. Wenn nein → [GateState.NeedsBackupPin] für optionalen
+     * Backup-Setup, sonst direkt Ready.
+     */
+    private suspend fun transitionAfterOnboarding() {
+        val existing = onboarding.tryMailBackupOrNull()
+        _gate.value = if (existing == null) GateState.NeedsBackupPin else GateState.Ready
+    }
+
+    /**
+     * I1-Fix: TGT-expired-during-onboarding routet auf [GateState.NeedsLsfLogin]
+     * statt [GateState.OnboardingError]. Andernfalls sieht der User "Erneut versuchen",
+     * der Retry feuert die gleiche Exception, User steckt fest. Hier erkennen
+     * wir die Auth-Exception (oder Marker-Strings aus der CAS/LSF-Schicht) und
+     * leiten ihn zurück zum "Mit Uni-Account anmelden"-Button.
+     */
+    private fun mapOnboardingFailure(t: Throwable): GateState {
+        val msg = t.message.orEmpty()
+        val isAuthFailure = t is AuthRequiredException ||
+            t.cause is AuthRequiredException ||
+            msg.contains("CAS-Login", ignoreCase = true) ||
+            msg.contains("AuthRequired", ignoreCase = true) ||
+            msg.contains("Service-Ticket", ignoreCase = true)
+        return if (isAuthFailure) GateState.NeedsLsfLogin
+        else GateState.OnboardingError(t.message ?: "Onboarding fehlgeschlagen")
+    }
+
+    /** Vom UI nach Rückkehr aus dem CAS-WebLogin gerufen — re-evaluiert das Gate. */
+    fun onCasLoginResult() {
+        viewModelScope.launch { refreshGate() }
+    }
+
+    fun submit(recipeHash: String, d: ReviewDraft) {
+        if (d.overall == 0 || d.wouldOrderAgain == null) {
+            _state.value = SubmitState.Error("Overall + Wieder-Bestellen sind Pflicht")
+            return
+        }
+        if (_gate.value !is GateState.Ready) {
+            _state.value = SubmitState.Error("Bitte zuerst LSF-Login + Onboarding abschließen")
+            return
+        }
+        viewModelScope.launch {
+            _state.value = SubmitState.Submitting
+            repo.submitReview(
+                recipeHash, d.overall, d.wouldOrderAgain,
+                d.taste, d.portion, d.value, d.satiation,
+            )
+                .onSuccess { _state.value = SubmitState.Done }
+                .onFailure { _state.value = SubmitState.Error(it.message ?: "Fehler") }
+        }
+    }
+}
