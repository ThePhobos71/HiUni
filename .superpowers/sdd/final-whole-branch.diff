+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+
+@RunWith(RobolectricTestRunner::class)
+class ReviewRepositoryTest {
+    private lateinit var db: AppDatabase
+    private lateinit var repo: ReviewRepository
+    private lateinit var keys: MyKeyManager
+
+    @Before fun setup() = runBlocking {
+        db = Room.inMemoryDatabaseBuilder(
+            ApplicationProvider.getApplicationContext(),
+            AppDatabase::class.java
+        ).allowMainThreadQueries().build()
+        keys = MyKeyManager(db.myKeyDao(), object : KeystoreWrap {
+            override fun wrap(s: ByteArray) = s
+            override fun unwrap(s: ByteArray) = s
+        })
+        repo = ReviewRepository(
+            db.reviewDao(), db.trustDao(), db.outboxDao(), db.mutedPubkeyDao(), keys
+        )
+        val kp = keys.create()
+        // Self-trust so aggregatableForRecipe returns the row
+        db.trustDao().insert(
+            TrustEntity(
+                pubkey = java.util.Base64.getEncoder().encodeToString(kp.publicKey),
+                source = "self",
+                depth = 0,
+                ts = 0L,
+                sig = "",
+            )
+        )
+    }
+
+    @After fun tearDown() = db.close()
+
+    @Test fun `submitReview persists signed event with own pubkey`() = runBlocking {
+        val event = repo.submitReview("hash1", overall = 4, wouldOrderAgain = true).getOrThrow()
+        assertTrue(event.sig.isNotEmpty())
+
+        val agg = repo.aggregateFor("hash1").first()
+        assertEquals(1, agg.overallCount)
+        assertEquals(4.0f, agg.overall ?: 0f, 0.01f)
+        assertEquals(100, agg.wouldOrderAgainPct)
+    }
+
+    @Test fun `aggregateFor returns null overall when no rows`() = runBlocking {
+        val agg = repo.aggregateFor("nonexistent").first()
+        assertEquals(0, agg.overallCount)
+        assertNull(agg.overall)
+        assertNull(agg.wouldOrderAgainPct)
+    }
+
+    @Test fun `submitReview adds entry to outbox`() = runBlocking {
+        val event = repo.submitReview("hash2", overall = 3, wouldOrderAgain = false).getOrThrow()
+        val outboxEntry = db.outboxDao().find(event.eventId())
+        assertNotNull(outboxEntry)
+        // Verify payload is non-empty JSON
+        assertNotNull(outboxEntry!!.payload)
+        assert(outboxEntry.payload.contains("hash2"))
+    }
+
+    @Test fun `retract marks event retracted and adds outbox entry`() = runBlocking {
+        val event = repo.submitReview("hash3", overall = 5, wouldOrderAgain = true).getOrThrow()
+        val eventId = event.eventId()
+
+        // Confirm it appears in aggregate before retraction
+        val before = repo.aggregateFor("hash3").first()
+        assertEquals(1, before.overallCount)
+
+        val retraction = repo.retract(eventId).getOrThrow()
+        assertTrue(retraction.sig.isNotEmpty())
+
+        // After retraction, aggregate should be empty
+        val after = repo.aggregateFor("hash3").first()
+        assertEquals(0, after.overallCount)
+
+        // Outbox should contain retraction
+        val outboxEntry = db.outboxDao().find(retraction.eventId())
+        assertNotNull(outboxEntry)
+    }
+
+    @Test fun `mute inserts into muted_pubkeys`() = runBlocking {
+        repo.mute("somePubkey")
+        val entry = db.mutedPubkeyDao().find("somePubkey")
+        assertNotNull(entry)
+    }
+
+    @Test fun `wouldOrderAgainPct rounds 2 of 3 trues to 67 not 66`() = runBlocking {
+        // 3 distinct trusted pubkeys → 3 reviews on same recipeHash, 2 with wouldOrderAgain=true
+        // Direct DAO inserts (repo.submitReview always signs with the single self key).
+        val hash = "hashRounding"
+        val kps = listOf(
+            Ed25519.generateKeypair(),
+            Ed25519.generateKeypair(),
+            Ed25519.generateKeypair(),
+        )
+        val votes = listOf(true, true, false)
+        kps.forEachIndexed { idx, kp ->
+            val pub = java.util.Base64.getEncoder().encodeToString(kp.publicKey)
+            db.trustDao().insert(
+                TrustEntity(
+                    pubkey = pub,
+                    source = "test",
+                    depth = 0,
+                    ts = 0L,
+                    sig = "",
+                )
+            )
+            val signed = ReviewEvent(
+                schemaVersion = 1,
+                recipeHash = hash,
+                overall = 4,
+                wouldOrderAgain = votes[idx],
+                taste = null,
+                portion = null,
+                value = null,
+                satiation = null,
+                ts = 1_000L + idx,
+                pubkey = pub,
+                sig = "",
+            ).signWith(kp)
+            db.reviewDao().insert(
+                ReviewEventEntity(
+                    eventId = signed.eventId(),
+                    recipeHash = hash,
+                    pubkey = pub,
+                    schemaVersion = 1,
+                    overall = 4,
+                    wouldOrderAgain = votes[idx],
+                    taste = null,
+                    portion = null,
+                    value = null,
+                    satiation = null,
+                    ts = signed.ts,
+                    sig = signed.sig,
+                    retracted = false,
+                )
+            )
+        }
+
+        val agg = repo.aggregateFor(hash).first()
+        assertEquals(3, agg.overallCount)
+        // 2/3 = 66.666… must round UP to 67, not truncate to 66
+        assertEquals(67, agg.wouldOrderAgainPct)
+    }
+
+    @Test fun `submitReview with dimension ratings populates byDimension`() = runBlocking {
+        repo.submitReview(
+            recipeHash = "hash4",
+            overall = 4,
+            wouldOrderAgain = true,
+            taste = 5,
+            portion = 3,
+        ).getOrThrow()
+
+        val agg = repo.aggregateFor("hash4").first()
+        assertEquals(1, agg.overallCount)
+        val tasteStat = agg.byDimension[Dimension.TASTE]
+        assertNotNull(tasteStat)
+        assertEquals(5.0f, tasteStat!!.avg, 0.01f)
+        assertEquals(1, tasteStat.n)
+
+        val portionStat = agg.byDimension[Dimension.PORTION]
+        assertNotNull(portionStat)
+        assertEquals(3.0f, portionStat!!.avg, 0.01f)
+
+        // value + satiation not set → absent from map
+        assertNull(agg.byDimension[Dimension.VALUE])
+        assertNull(agg.byDimension[Dimension.SATIATION])
+    }
+}
