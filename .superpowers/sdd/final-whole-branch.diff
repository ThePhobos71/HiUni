@@ -0,0 +1,78 @@
+package de.transio.hiuni.feature.mensa.review.trust
+
+import de.transio.hiuni.events.IntroEvent
+import de.transio.hiuni.events.signWith
+import de.transio.hiuni.feature.mensa.review.data.OutboxDao
+import de.transio.hiuni.feature.mensa.review.data.OutboxEntity
+import de.transio.hiuni.feature.mensa.review.data.TrustDao
+import de.transio.hiuni.feature.mensa.review.data.TrustEntity
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import java.util.Base64
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Lets an already-validated user introduce a new pubkey into the Web-of-Trust
+ * by emitting a signed [IntroEvent]. Mirrors `ReviewRepository.submitReview` in spirit.
+ *
+ * Preconditions checked in order — first failure short-circuits with a clear message:
+ * 1. We own a keypair (otherwise we have nothing to sign with).
+ * 2. Our own pubkey appears in the local `trust` table (we have been validated).
+ * 3. Our depth is < 2 — at depth 2 the inviter rule (invitee.depth = inviter.depth + 1, max 2)
+ *    would already be violated.
+ * 4. We have not yet exhausted the 5-invite lifetime limit (counted as the number of
+ *    local trust rows whose `source` is us).
+ *
+ * On success the IntroEvent is queued in the outbox (relay flusher takes over) AND
+ * inserted into the local trust table immediately so the inviter sees the new contact
+ * as trusted without waiting for a relay roundtrip.
+ */
+@Singleton
+class IntroIssuer @Inject constructor(
+    private val keys: MyKeyManager,
+    private val trustDao: TrustDao,
+    private val outbox: OutboxDao,
+    private val json: Json,
+) {
+    suspend fun issueIntro(inviteePubkey: String): Result<IntroEvent> = runCatching {
+        val kp = keys.getOrNull() ?: error("no key — onboarding required")
+        val pub = Base64.getEncoder().encodeToString(kp.publicKey)
+        require(inviteePubkey != pub) { "self-invite is not allowed" }
+
+        val mine = trustDao.find(pub) ?: error("not yet validated — cannot invite")
+        if (mine.depth >= 2) error("depth too deep to invite")
+
+        val count = trustDao.countIntrosBy(pub)
+        if (count >= MAX_INVITES) error("invite limit reached ($MAX_INVITES)")
+
+        val ev = IntroEvent(
+            invitee = inviteePubkey,
+            inviter = pub,
+            ts = System.currentTimeMillis(),
+            sig = "",
+        ).signWith(kp)
+
+        outbox.insert(
+            OutboxEntity(
+                eventId = ev.eventId(),
+                payload = json.encodeToString(ev),
+                lastAttempt = null,
+            )
+        )
+        trustDao.insert(
+            TrustEntity(
+                pubkey = inviteePubkey,
+                source = pub,
+                depth = mine.depth + 1,
+                ts = ev.ts,
+                sig = ev.sig,
+            )
+        )
+        ev
+    }
+
+    companion object {
+        const val MAX_INVITES = 5
+    }
+}
