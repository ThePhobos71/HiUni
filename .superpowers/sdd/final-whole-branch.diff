+++ b/app/src/main/java/de/transio/hiuni/feature/mensa/review/sync/RelayClient.kt
@@ -0,0 +1,322 @@
+package de.transio.hiuni.feature.mensa.review.sync
+
+import de.transio.hiuni.events.AcceptResult
+import de.transio.hiuni.events.IntroEvent
+import de.transio.hiuni.events.RetractionEvent
+import de.transio.hiuni.events.ReviewEvent
+import de.transio.hiuni.events.SignedEvent
+import de.transio.hiuni.events.SyncFrame
+import de.transio.hiuni.events.ValidationEvent
+import de.transio.hiuni.feature.mensa.review.data.OutboxDao
+import de.transio.hiuni.feature.mensa.review.data.PeerCursorDao
+import de.transio.hiuni.feature.mensa.review.data.PeerCursorEntity
+import de.transio.hiuni.feature.mensa.review.data.ReviewDao
+import de.transio.hiuni.feature.mensa.review.data.ReviewEventEntity
+import de.transio.hiuni.feature.mensa.review.data.TrustDao
+import de.transio.hiuni.feature.mensa.review.data.TrustEntity
+import de.transio.hiuni.feature.mensa.review.di.RelayHttpClient
+import de.transio.hiuni.feature.mensa.review.trust.MyKeyManager
+import de.transio.hiuni.events.toBase64
+import timber.log.Timber
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.decodeFromJsonElement
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.Response
+import okhttp3.WebSocket
+import okhttp3.WebSocketListener
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Persistente WebSocket-Verbindung zum HiUni-Relay.
+ *
+ * Lifecycle: [start] startet die Verbindung und gibt einen StateFlow zurück,
+ * der über UI-relevante Zustandswechsel informiert. Auto-Reconnect mit 3–5s
+ * Backoff bei Disconnect/Failure. [stop] schliesst sauber.
+ *
+ * Wire-Protokoll (siehe [SyncFrame]):
+ *  - Client → Server: `Hello(since = letzter lokaler Cursor)`.
+ *  - Server → Client: `Events(items, hasMore, cursor)` — wenn hasMore, neuer
+ *    Hello mit aktualisiertem Cursor; sonst State auf [RelayState.Synced]
+ *    und Outbox flushen.
+ *  - Server → Client (live): `Event(kind, data)` — direkter Ingest ohne
+ *    Cursor-Update (live broadcast vom Relay).
+ *
+ * Ingest: Polymorpher JsonElement → konkreter [SignedEvent] → Validator-Check
+ * → Persistenz in DAOs. Events, die der Validator ablehnt, werden stillschweigend
+ * verworfen (keine Bestätigung an den Server).
+ */
+@Singleton
+class RelayClient @Inject constructor(
+    @RelayHttpClient private val http: OkHttpClient,
+    private val cfg: RelayConfig,
+    private val reviewDao: ReviewDao,
+    private val trustDao: TrustDao,
+    private val outbox: OutboxDao,
+    private val cursors: PeerCursorDao,
+    private val validatorFactory: ValidatorFactory,
+    private val myKeys: MyKeyManager,
+) {
+    private val state = MutableStateFlow<RelayState>(RelayState.Disconnected)
+
+    // Polymorpher Sealed-Type wird über das `type`-Feld unterschieden (siehe @SerialName
+    // in SyncFrame.kt). `classDiscriminator = "type"` muss mit der Relay-Seite identisch
+    // sein, sonst schlägt die Polymorphie still fehl.
+    private val json: Json = Json {
+        ignoreUnknownKeys = true
+        classDiscriminator = "type"
+    }
+
+    private val scope = CoroutineScope(Dispatchers.IO + SupervisorJob())
+
+    @Volatile private var ws: WebSocket? = null
+    @Volatile private var reconnectJob: Job? = null
+    @Volatile private var stopped = false
+
+    // In-memory tail des composite cursor (ts, eventId). Wird aus jedem Events-Frame
+    // aktualisiert und im nächsten Hello an den Relay mitgegeben, damit der Server bei
+    // ts-Kollisionen am Batch-Rand korrekt nach eventId weiterschneidet.
+    // TODO(persist-cursor-id): über App-Restart erhalten — bei V1 OK, weil ts-Kollisionen
+    //  genau am Restart-Boundary extrem unwahrscheinlich sind.
+    @Volatile private var lastCursorId: String? = null
+
+    private val peerId = "relay"
+
+    /**
+     * Startet den WebSocket und liefert einen Hot-Flow mit dem aktuellen
+     * Verbindungszustand. Mehrfaches Aufrufen ist idempotent — nur der erste
+     * Call öffnet eine Verbindung (`ws == null && !stopped` guard).
+     *
+     * Aufrufer: [HiUniApplication.maybeStartRelayClient] beim Cold-Start
+     * (sobald key+master persistent vorliegen) und
+     * [de.transio.hiuni.feature.mensa.review.trust.LsfOnboarding.startOnboarding]
+     * direkt nach erfolgreichem /validate (First-Session-Boot).
+     */
+    fun start(): Flow<RelayState> {
+        if (ws == null && !stopped) {
+            connect()
+        }
+        return state.asStateFlow()
+    }
+
+    /** Schliesst die Verbindung und cancelt Auto-Reconnect. */
+    fun stop() {
+        stopped = true
+        reconnectJob?.cancel()
+        reconnectJob = null
+        ws?.close(NORMAL_CLOSURE, "user")
+        ws = null
+        state.value = RelayState.Disconnected
+    }
+
+    /** Cancelt den internen Scope endgültig. Nur für Hilt-Singleton-Teardown / Tests. */
+    fun shutdown() {
+        stop()
+        scope.cancel()
+    }
+
+    private fun connect() {
+        if (stopped) return
+        state.value = RelayState.Connecting
+        val req = Request.Builder().url("${cfg.baseUrl}/sync").build()
+        ws = http.newWebSocket(req, Listener())
+    }
+
+    private inner class Listener : WebSocketListener() {
+        override fun onOpen(socket: WebSocket, response: Response) {
+            scope.launch { runCatching { sendHello(socket) } }
+        }
+
+        override fun onMessage(socket: WebSocket, text: String) {
+            scope.launch { runCatching { handleFrame(socket, text) } }
+        }
+
+        override fun onClosed(socket: WebSocket, code: Int, reason: String) {
+            state.value = RelayState.Disconnected
+            scheduleReconnect(RECONNECT_CLOSE_MS)
+        }
+
+        override fun onFailure(socket: WebSocket, t: Throwable, response: Response?) {
+            state.value = RelayState.Disconnected
+            scheduleReconnect(RECONNECT_FAILURE_MS)
+        }
+    }
+
+    private fun scheduleReconnect(delayMs: Long) {
+        if (stopped) return
+        ws = null
+        reconnectJob?.cancel()
+        reconnectJob = scope.launch {
+            delay(delayMs)
+            if (!stopped) connect()
+        }
+    }
+
+    private suspend fun sendHello(socket: WebSocket) {
+        val existing = cursors.find(peerId)
+        val cursor = existing?.lastSeenTs ?: 0L
+        if (existing == null) {
+            cursors.insert(PeerCursorEntity(peerId = peerId, lastSeenTs = 0L))
+        }
+        socket.send(
+            json.encodeToString<SyncFrame>(
+                SyncFrame.Hello(since = cursor, sinceId = lastCursorId)
+            )
+        )
+    }
+
+    private suspend fun handleFrame(socket: WebSocket, text: String) {
+        val frame = json.decodeFromString<SyncFrame>(text)
+        when (frame) {
+            is SyncFrame.Events -> {
+                frame.items.forEach { ingest(it) }
+                cursors.insert(PeerCursorEntity(peerId = peerId, lastSeenTs = frame.cursor))
+                lastCursorId = frame.cursorId
+                if (frame.hasMore) {
+                    socket.send(
+                        json.encodeToString<SyncFrame>(
+                            SyncFrame.Hello(since = frame.cursor, sinceId = frame.cursorId)
+                        )
+                    )
+                } else {
+                    state.value = RelayState.Synced
+                    flushOutbox(socket)
+                }
+            }
+            is SyncFrame.Event -> {
+                ingest(frame.data)
+            }
+            is SyncFrame.Pong, is SyncFrame.Hello, is SyncFrame.Ping -> {
+                // Hello/Ping kommen vom Client, Pong reicht uns Awareness — kein State-Change.
+            }
+        }
+    }
+
+    private suspend fun ingest(element: JsonElement) {
+        val obj = element.jsonObject
+        val type = obj["type"]?.jsonPrimitive?.content ?: return
+        val event: SignedEvent = when (type) {
+            "review"     -> json.decodeFromJsonElement<ReviewEvent>(element)
+            "validation" -> json.decodeFromJsonElement<ValidationEvent>(element)
+            "intro"      -> json.decodeFromJsonElement<IntroEvent>(element)
+            "retraction" -> json.decodeFromJsonElement<RetractionEvent>(element)
+            else -> return
+        }
+
+        // I5-Fix: Race zwischen /validate-HTTP-Response (persistiert masterPubkey
+        // + TrustEntity in LsfOnboarding) und broadcastAll(ValidationEvent) auf
+        // dem Relay. Wenn die WS bereits offen ist, kann das Broadcast hier
+        // ankommen, bevor der Pubkey adoptiert wurde — Validator würde rejecten.
+        // LsfOnboarding persistiert es ohnehin selbst, also einfach skip.
+        if (event is ValidationEvent) {
+            val myPubkey = myKeys.getOrNull()?.publicKey?.toBase64()
+            if (myPubkey != null && event.pubkey_ == myPubkey) {
+                Timber.i("RelayClient: skip self-validation broadcast (LsfOnboarding persists it directly)")
+                return
+            }
+        }
+
+        val validator = validatorFactory.create()
+        when (validator.accept(event)) {
+            is AcceptResult.Ok -> persist(event)
+            is AcceptResult.Reject -> {
+                // Bewusst kein Logging hier — Reject ist Normalbetrieb (Spam, Trust-Lücken).
+            }
+        }
+    }
+
+    private suspend fun persist(e: SignedEvent) {
+        when (e) {
+            is ReviewEvent -> reviewDao.insert(
+                ReviewEventEntity(
+                    eventId = e.eventId(),
+                    recipeHash = e.recipeHash,
+                    pubkey = e.pubkey,
+                    schemaVersion = e.schemaVersion,
+                    overall = e.overall,
+                    wouldOrderAgain = e.wouldOrderAgain,
+                    taste = e.taste,
+                    portion = e.portion,
+                    value = e.value,
+                    satiation = e.satiation,
+                    ts = e.ts,
+                    sig = e.sig,
+                    retracted = false,
+                )
+            )
+            is RetractionEvent -> reviewDao.markRetracted(e.targetEventId)
+            is ValidationEvent -> trustDao.insert(
+                TrustEntity(
+                    pubkey = e.pubkey,
+                    source = "relay",
+                    depth = 0,
+                    ts = e.ts,
+                    sig = e.sig,
+                )
+            )
+            is IntroEvent -> {
+                val parentDepth = trustDao.find(e.inviter)?.depth
+                if (parentDepth == null) {
+                    // M1-Fix: orphan IntroEvent (inviter noch nicht im lokalen
+                    // Trust-Graph) — bisher silent gedroppt. Jetzt zumindest
+                    // sichtbar im Log, damit Trust-Lücken im Debug auffallen.
+                    // V1 verzichtet auf eine Pending-Queue.
+                    Timber.w("RelayClient: drop orphan IntroEvent — inviter %s not trusted locally", e.inviter.take(8))
+                    return
+                }
+                val newDepth = parentDepth + 1
+                if (newDepth <= MAX_TRUST_DEPTH) {
+                    trustDao.insert(
+                        TrustEntity(
+                            pubkey = e.invitee,
+                            source = e.inviter,
+                            depth = newDepth,
+                            ts = e.ts,
+                            sig = e.sig,
+                        )
+                    )
+                }
+            }
+        }
+    }
+
+    private suspend fun flushOutbox(socket: WebSocket) {
+        outbox.getAll().forEach { entry ->
+            val payload = runCatching { json.parseToJsonElement(entry.payload) }.getOrNull() ?: return@forEach
+            val kind = payload.jsonObject["type"]?.jsonPrimitive?.content ?: return@forEach
+            val ok = socket.send(json.encodeToString<SyncFrame>(SyncFrame.Event(kind = kind, data = payload)))
+            if (ok) outbox.delete(entry.eventId)
+            // Wenn `send` false zurückgibt (Buffer voll oder Socket halb-tot), brechen wir nicht
+            // hart ab — beim nächsten Synced-Cycle wird der Outbox-Rest erneut probiert.
+        }
+    }
+
+    private companion object {
+        const val NORMAL_CLOSURE = 1000
+        const val RECONNECT_CLOSE_MS = 3_000L
+        const val RECONNECT_FAILURE_MS = 5_000L
+        const val MAX_TRUST_DEPTH = 2
+    }
+}
+
+/** Sichtbarer Verbindungszustand für UI / Task 21. */
+sealed class RelayState {
+    object Connecting : RelayState()
+    object Synced : RelayState()
+    object Disconnected : RelayState()
+}
