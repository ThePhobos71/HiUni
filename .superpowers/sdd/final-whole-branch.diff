+import java.util.Base64
+
+@RunWith(RobolectricTestRunner::class)
+class IntroIssuerTest {
+
+    private lateinit var db: AppDatabase
+    private lateinit var trustDao: TrustDao
+    private lateinit var outbox: OutboxDao
+    private lateinit var myKeyDao: MyKeyDao
+    private lateinit var keys: MyKeyManager
+    private lateinit var issuer: IntroIssuer
+
+    private class IdentityWrap : KeystoreWrap {
+        override fun wrap(secret: ByteArray) = secret
+        override fun unwrap(wrapped: ByteArray) = wrapped
+    }
+
+    @Before fun setup() {
+        db = Room.inMemoryDatabaseBuilder(
+            ApplicationProvider.getApplicationContext(),
+            AppDatabase::class.java
+        )
+            .allowMainThreadQueries()
+            .build()
+        trustDao = db.trustDao()
+        outbox = db.outboxDao()
+        myKeyDao = db.myKeyDao()
+        keys = MyKeyManager(myKeyDao, IdentityWrap())
+        issuer = IntroIssuer(keys, trustDao, outbox, Json { ignoreUnknownKeys = true })
+    }
+
+    @After fun tearDown() = db.close()
+
+    private suspend fun ownPubB64(): String {
+        val kp = keys.getOrNull() ?: keys.create()
+        return Base64.getEncoder().encodeToString(kp.publicKey)
+    }
+
+    @Test fun `happy path issues signed IntroEvent and updates outbox + trust`() = runBlocking {
+        keys.create()
+        val pub = ownPubB64()
+        trustDao.insert(TrustEntity(pub, "relay", 0, 100L, "sig"))
+
+        val invitee = "INVITEE_PUBKEY_B64=="
+        val result = issuer.issueIntro(invitee)
+
+        assertTrue("expected success, got $result", result.isSuccess)
+        val ev: IntroEvent = result.getOrThrow()
+        assertEquals(invitee, ev.invitee)
+        assertEquals(pub, ev.inviter)
+        assertFalse("sig must not be empty", ev.sig.isEmpty())
+        assertTrue("event must verify with own pubkey", ev.verify())
+
+        // outbox got the signed payload
+        val outRow = outbox.find(ev.eventId())
+        assertNotNull(outRow)
+        assertTrue("outbox payload should embed sig", outRow!!.payload.contains(ev.sig))
+
+        // local trust table is updated optimistically: invitee trusted at depth+1
+        val trustedInvitee = trustDao.find(invitee)
+        assertNotNull(trustedInvitee)
+        assertEquals(1, trustedInvitee!!.depth)
+        assertEquals(pub, trustedInvitee.source)
+    }
+
+    @Test fun `fails when no own keypair`() = runBlocking {
+        // no keys.create()
+        val result = issuer.issueIntro("anyone")
+        assertTrue(result.isFailure)
+        assertTrue(result.exceptionOrNull()!!.message!!.contains("no key", ignoreCase = true))
+    }
+
+    @Test fun `fails when own depth is too deep to invite`() = runBlocking {
+        keys.create()
+        val pub = ownPubB64()
+        trustDao.insert(TrustEntity(pub, "someone", 2, 100L, "sig"))
+
+        val result = issuer.issueIntro("invitee")
+        assertTrue(result.isFailure)
+        assertTrue(result.exceptionOrNull()!!.message!!.contains("depth", ignoreCase = true))
+        // nothing leaked into trust/outbox
+        assertNull(trustDao.find("invitee"))
+        assertTrue(outbox.getAll().isEmpty())
+    }
+
+    @Test fun `fails when 5-invite lifetime limit is exhausted`() = runBlocking {
+        keys.create()
+        val pub = ownPubB64()
+        trustDao.insert(TrustEntity(pub, "relay", 0, 100L, "sig"))
+        // 5 prior invitees already attributed to me as source
+        repeat(5) { i ->
+            trustDao.insert(TrustEntity("invitee$i", pub, 1, 100L + i, "s$i"))
+        }
+
+        val result = issuer.issueIntro("nope")
+        assertTrue(result.isFailure)
+        assertTrue(result.exceptionOrNull()!!.message!!.contains("limit", ignoreCase = true))
+        assertNull(trustDao.find("nope"))
+    }
+
+    @Test fun `fails when not yet validated (own pubkey not in trust)`() = runBlocking {
+        keys.create()
+        // no trust row for ourselves
+        val result = issuer.issueIntro("invitee")
+        assertTrue(result.isFailure)
+    }
+}
