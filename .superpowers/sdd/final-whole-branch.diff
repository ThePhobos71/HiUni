+
+/**
+ * Recovery-Prompt für ein gefundenes Mail-Backup. Zeigt das Erstellungs-Datum,
+ * sammelt die 6-stellige Backup-PIN und bietet Hard-Reset + Konto-Wechsel als
+ * Alternativen.
+ *
+ * Versuche-Logik: 3 Versuche, danach wird der "Wiederherstellen"-Button durch
+ * den Hard-Reset-Hinweis ersetzt. Die Versuchszählung passiert NICHT hier,
+ * sondern im ViewModel — wir rendern nur, was uns reingegeben wird.
+ */
+@Composable
+fun RecoveryPinSection(
+    backupCreatedAt: Long,
+    attemptsLeft: Int,
+    error: String?,
+    onSubmit: (String) -> Unit,
+    onHardReset: () -> Unit,
+    onSwitchAccount: () -> Unit,
+) {
+    var pin by remember { mutableStateOf("") }
+    val formattedDate = remember(backupCreatedAt) {
+        DateFormat.getDateInstance(DateFormat.MEDIUM).format(Date(backupCreatedAt))
+    }
+    val exhausted = attemptsLeft <= 0
+
+    Surface(
+        color = MaterialTheme.colorScheme.surfaceVariant,
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(vertical = 4.dp),
+    ) {
+        Column(
+            Modifier.padding(12.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            Text(
+                "Backup gefunden",
+                style = MaterialTheme.typography.titleSmall,
+            )
+            Text(
+                "Wir haben dein altes Backup vom $formattedDate gefunden — Backup-PIN eingeben?",
+                style = MaterialTheme.typography.bodySmall,
+            )
+
+            if (!exhausted) {
+                OutlinedTextField(
+                    value = pin,
+                    onValueChange = { input ->
+                        // 6-stellig numerisch, alles andere droppen
+                        pin = input.filter { it.isDigit() }.take(6)
+                    },
+                    label = { Text("Backup-PIN (6 Ziffern)") },
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.NumberPassword),
+                    visualTransformation = PasswordVisualTransformation(),
+                    modifier = Modifier.fillMaxWidth(),
+                )
+
+                if (error != null) {
+                    Text(
+                        error,
+                        color = MaterialTheme.colorScheme.error,
+                        style = MaterialTheme.typography.bodySmall,
+                    )
+                }
+
+                Row(verticalAlignment = androidx.compose.ui.Alignment.CenterVertically) {
+                    Button(
+                        onClick = { onSubmit(pin) },
+                        enabled = pin.length == 6,
+                    ) {
+                        Text("Wiederherstellen")
+                    }
+                    Spacer(Modifier.width(8.dp))
+                    TextButton(onClick = onSwitchAccount) {
+                        Text("Mit anderem Konto anmelden")
+                    }
+                }
+            } else {
+                Text(
+                    "Drei Fehlversuche — das Backup bleibt verschlossen. " +
+                        "Du kannst stattdessen einen frischen Pubkey via LSF anlegen " +
+                        "(deine alten Bewertungen sind dann nicht mehr deine).",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.error,
+                )
+                Spacer(Modifier.height(4.dp))
+                Row {
+                    Button(onClick = onHardReset) {
+                        Text("Hard-Reset (neuer Pubkey)")
+                    }
+                    Spacer(Modifier.width(8.dp))
+                    OutlinedButton(onClick = onSwitchAccount) {
+                        Text("Konto wechseln")
+                    }
+                }
+            }
+        }
+    }
+}
+
+/**
+ * Backup-Setup-Prompt nach erfolgreichem Onboarding. Optional — User kann
+ * skippen und das Backup später anlegen. Gleiches PIN-Format wie Recovery.
+ */
+@Composable
+fun BackupSetupSection(
+    onSubmit: (String) -> Unit,
+    onSkip: () -> Unit,
+) {
+    var pin by remember { mutableStateOf("") }
+    var confirm by remember { mutableStateOf("") }
+    val pinsMatch = pin.length == 6 && pin == confirm
+
+    Surface(
+        color = MaterialTheme.colorScheme.surfaceVariant,
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(vertical = 4.dp),
+    ) {
+        Column(
+            Modifier.padding(12.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            Text(
+                "Backup einrichten (optional)",
+                style = MaterialTheme.typography.titleSmall,
+            )
+            Text(
+                "Hinterleg eine 6-stellige PIN — wir verschlüsseln deinen Schlüssel und legen ihn in deinen Mail-Entwürfen ab. So bleiben deine Bewertungen auf einem neuen Gerät weiter dir zugeordnet.",
+                style = MaterialTheme.typography.bodySmall,
+            )
+
+            OutlinedTextField(
+                value = pin,
+                onValueChange = { input -> pin = input.filter { it.isDigit() }.take(6) },
+                label = { Text("Neue PIN (6 Ziffern)") },
+                singleLine = true,
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.NumberPassword),
+                visualTransformation = PasswordVisualTransformation(),
+                modifier = Modifier.fillMaxWidth(),
+            )
+            OutlinedTextField(
+                value = confirm,
+                onValueChange = { input -> confirm = input.filter { it.isDigit() }.take(6) },
+                label = { Text("PIN bestätigen") },
+                singleLine = true,
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.NumberPassword),
+                visualTransformation = PasswordVisualTransformation(),
+                modifier = Modifier.fillMaxWidth(),
+            )
+
+            if (pin.length == 6 && confirm.length == 6 && pin != confirm) {
+                Text(
+                    "PINs stimmen nicht überein",
+                    color = MaterialTheme.colorScheme.error,
+                    style = MaterialTheme.typography.bodySmall,
+                )
+            }
+
+            Row {
+                Button(
+                    onClick = { onSubmit(pin) },
+                    enabled = pinsMatch,
+                ) {
+                    Text("Backup speichern")
+                }
+                Spacer(Modifier.width(8.dp))
+                TextButton(onClick = onSkip) {
+                    Text("Überspringen")
+                }
+            }
+        }
+    }
+}
