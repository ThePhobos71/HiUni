+++ b/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MailIntroScanner.kt
@@ -0,0 +1,148 @@
+package de.transio.hiuni.feature.mensa.review.trust
+
+import de.transio.hiuni.core.security.CredentialsManager
+import de.transio.hiuni.di.IoDispatcher
+import jakarta.mail.Flags
+import jakarta.mail.Folder
+import jakarta.mail.Session
+import jakarta.mail.search.SubjectTerm
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.withContext
+import org.eclipse.angus.mail.imap.IMAPFolder
+import timber.log.Timber
+import java.util.Properties
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Periodischer Mail-Scanner für eingehende `HIUNI-INTRO-v1`-Mails.
+ *
+ * Sucht im INBOX-Folder nach Subject-Matches, parst sie via [MailIntroReceiver.parse],
+ * importiert die IntroEvents über [MailIntroReceiver.import] und markiert die Mail
+ * danach als `\Seen` (so dass sie im normalen Inbox-Workflow nicht stört).
+ *
+ * Verwendet dasselbe IMAPS-Pattern wie [MailBackup] — eigene Session pro Operation,
+ * keine Connection-Reuse. Wird vom [de.transio.hiuni.core.startup.StartupRefresher]
+ * angetriggert.
+ *
+ * Bewusst NICHT: hartes Löschen der Mail (`\Deleted` + expunge). Der User soll die
+ * Mail im Posteingang sehen können — die ist Beweis und Audit-Trail des Onboarding.
+ */
+@Singleton
+class MailIntroScanner @Inject constructor(
+    private val credentials: CredentialsManager,
+    private val receiver: MailIntroReceiver,
+    @IoDispatcher private val io: CoroutineDispatcher,
+) {
+
+    /**
+     * Sucht in INBOX nach allen Mails mit Subject `HIUNI-INTRO-v1`, parst und importiert.
+     *
+     * No-op wenn keine Credentials hinterlegt sind (Onboarding noch nicht durch).
+     * Fängt ALLE Exceptions intern — schlägt nie raus an den Caller. Diese Funktion
+     * ist Best-Effort und darf den App-Start nicht zerschießen.
+     *
+     * @return Anzahl erfolgreich importierter Events (für Logging/Tests).
+     */
+    suspend fun scanOnce(): Int = withContext(io) {
+        if (!credentials.hasCredentials()) {
+            Timber.d("MailIntroScanner.scanOnce: keine Credentials, skip")
+            return@withContext 0
+        }
+        runCatching {
+            val (user, password) = requireCredentials()
+            val store = openStore(user, password)
+            var imported = 0
+            try {
+                val folder = store.getFolder("INBOX") as IMAPFolder
+                folder.open(Folder.READ_WRITE)
+                try {
+                    val matches = folder.search(SubjectTerm(MAIL_INTRO_SUBJECT))
+                    if (matches.isEmpty()) {
+                        Timber.d("MailIntroScanner.scanOnce: keine Intro-Mails in INBOX")
+                        return@runCatching 0
+                    }
+                    Timber.i("MailIntroScanner.scanOnce: ${matches.size} Intro-Mail(s) gefunden")
+                    for (msg in matches) {
+                        // Body extrahieren — Plain-Text bevorzugt, sonst erstes Multipart-Part.
+                        val body = extractPlainBody(msg)
+                        if (body.isNullOrBlank()) {
+                            Timber.w("MailIntroScanner: leerer Body in Intro-Mail, skip")
+                            continue
+                        }
+                        val event = receiver.parse(body)
+                        if (event == null) {
+                            Timber.w("MailIntroScanner: parse failed (ImportResult.ParseError)")
+                            continue
+                        }
+                        val result = receiver.import(event)
+                        Timber.i("MailIntroScanner: import inviter=${event.inviter.take(8)}… → $result")
+                        if (result == ImportResult.Ok) {
+                            imported++
+                            // Erfolg → als gelesen markieren, damit User die Mail nicht
+                            // noch als unread sieht. Bewusst KEIN Delete (siehe Klassen-KDoc).
+                            runCatching { msg.setFlag(Flags.Flag.SEEN, true) }
+                        }
+                    }
+                } finally {
+                    folder.close(false)
+                }
+            } finally {
+                store.close()
+            }
+            imported
+        }.onFailure {
+            Timber.w(it, "MailIntroScanner.scanOnce fehlgeschlagen")
+        }.getOrDefault(0)
+    }
+
+    private fun requireCredentials(): Pair<String, String> {
+        val user = credentials.getUsername()
+            ?: error("Kein IMAP-Username hinterlegt")
+        val password = credentials.getPassword()
+            ?: error("Kein IMAP-Passwort hinterlegt")
+        return user to password
+    }
+
+    private fun openStore(user: String, password: String): jakarta.mail.Store {
+        val props = Properties().apply {
+            put("mail.store.protocol", "imaps")
+            put("mail.imaps.host", IMAP_HOST)
+            put("mail.imaps.port", IMAP_PORT.toString())
+            put("mail.imaps.ssl.enable", "true")
+            put("mail.imaps.ssl.checkserveridentity", "true")
+            put("mail.imaps.connectiontimeout", "15000")
+            put("mail.imaps.timeout", "20000")
+            put("mail.mime.charset", "UTF-8")
+        }
+        val session = Session.getInstance(props)
+        val store = session.getStore("imaps")
+        store.connect(IMAP_HOST, IMAP_PORT, user, password)
+        return store
+    }
+
+    private fun extractPlainBody(msg: jakarta.mail.Message): String? {
+        return runCatching {
+            when (val content = msg.content) {
+                is String -> content
+                is jakarta.mail.Multipart -> {
+                    // Erste text/plain Part suchen
+                    for (i in 0 until content.count) {
+                        val part = content.getBodyPart(i)
+                        if (part.isMimeType("text/plain")) {
+                            return@runCatching part.content as? String
+                        }
+                    }
+                    // Fallback: erstes Part
+                    if (content.count > 0) content.getBodyPart(0).content as? String else null
+                }
+                else -> null
+            }
+        }.getOrNull()
+    }
+
+    private companion object {
+        const val IMAP_HOST = "mail.uni-hildesheim.de"
+        const val IMAP_PORT = 993
+    }
+}
diff --git a/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MyKeyManager.kt b/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MyKeyManager.kt
