+ * 24h-Refresh-Intervall der Wahrscheinlichkeit reicht (App wird typischerweise
+ * mindestens einmal pro Tag geöffnet).
  */
 @Singleton
 class StartupRefresher @Inject constructor(
     private val moviesRepository: MoviesRepository,
     private val mensaRepository: MensaRepository,
     private val sportRepository: SportRepository,
+    private val mailIntroScanner: MailIntroScanner,
     @ApplicationScope private val scope: CoroutineScope
 ) {
     private val triggered = AtomicBoolean(false)
 
     fun trigger() {
         if (!triggered.compareAndSet(false, true)) return
         scope.launch {
             runCatching { moviesRepository.refresh(force = false) }
                 .onFailure { Timber.w(it, "Startup-Refresh Movies fehlgeschlagen") }
         }
         scope.launch {
             runCatching { mensaRepository.refresh(force = false) }
                 .onFailure { Timber.w(it, "Startup-Refresh Mensa fehlgeschlagen") }
         }
         scope.launch {
             runCatching { sportRepository.refresh(force = false) }
                 .onFailure { Timber.w(it, "Startup-Refresh Sport fehlgeschlagen") }
         }
+        scope.launch {
+            // Mail-Intro-Scan: sucht eingegangene HIUNI-INTRO-v1-Mails und importiert
+            // sie in die Trust-Tabelle. Best-Effort, scanOnce() fängt alle Exceptions
+            // intern und gibt nur die Anzahl importierter Events zurück.
+            runCatching { mailIntroScanner.scanOnce() }
+                .onSuccess { count -> if (count > 0) Timber.i("Startup MailIntroScan: $count Intro(s) importiert") }
+                .onFailure { Timber.w(it, "Startup MailIntroScan fehlgeschlagen") }
+        }
     }
 }
