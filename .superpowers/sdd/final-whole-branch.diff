@@ -0,0 +1,73 @@
+package de.transio.hiuni.events
+
+import com.google.crypto.tink.signature.SignatureConfig
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import org.junit.Assert.*
+import org.junit.BeforeClass
+import org.junit.Test
+
+/**
+ * Regression-Guard für C1 (Task 20 Review): SignedEvent.type war ein computed getter
+ * ohne backing field — kotlinx-serialization hat das NICHT serialisiert. Diese Tests
+ * verifizieren, dass `type` jetzt im JSON-Output erscheint und ein Round-Trip die
+ * Signatur erhält.
+ */
+class SerializationTest {
+    companion object {
+        @BeforeClass @JvmStatic fun init() { SignatureConfig.register() }
+    }
+    private val json = Json { ignoreUnknownKeys = true }
+
+    @Test fun `ReviewEvent JSON contains type field`() {
+        val kp = Ed25519.generateKeypair()
+        val e = ReviewEvent(
+            schemaVersion = 1, recipeHash = "h", overall = 4,
+            wouldOrderAgain = true, taste = null, portion = null, value = null,
+            satiation = null, ts = 100L, pubkey = kp.publicKey.toBase64(), sig = "",
+        ).signWith(kp)
+        val out = json.encodeToString(e)
+        assertTrue("type field missing in JSON: $out", out.contains("\"type\":\"review\""))
+    }
+
+    @Test fun `ReviewEvent round-trips through JSON and verifies sig`() {
+        val kp = Ed25519.generateKeypair()
+        val original = ReviewEvent(
+            schemaVersion = 1, recipeHash = "h", overall = 4,
+            wouldOrderAgain = true, taste = null, portion = null, value = null,
+            satiation = null, ts = 100L, pubkey = kp.publicKey.toBase64(), sig = "",
+        ).signWith(kp)
+        val restored = json.decodeFromString<ReviewEvent>(json.encodeToString(original))
+        assertEquals(original, restored)
+        assertTrue(restored.verify())
+    }
+
+    @Test fun `Each event type serializes its own type discriminator`() {
+        val kp = Ed25519.generateKeypair()
+        val pub = kp.publicKey.toBase64()
+        assertTrue(
+            json.encodeToString(
+                ReviewEvent(
+                    schemaVersion = 1, recipeHash = "h", overall = 4, wouldOrderAgain = true,
+                    taste = null, portion = null, value = null, satiation = null,
+                    ts = 100L, pubkey = pub, sig = "",
+                )
+            ).contains("\"type\":\"review\"")
+        )
+        assertTrue(
+            json.encodeToString(
+                ValidationEvent(pubkey_ = pub, ts = 100L, issuer = "relay", sig = "")
+            ).contains("\"type\":\"validation\"")
+        )
+        assertTrue(
+            json.encodeToString(
+                IntroEvent(invitee = pub, inviter = pub, ts = 100L, sig = "")
+            ).contains("\"type\":\"intro\"")
+        )
+        assertTrue(
+            json.encodeToString(
+                RetractionEvent(targetEventId = "x", ts = 100L, pubkey = pub, sig = "")
+            ).contains("\"type\":\"retraction\"")
+        )
+    }
+}
