+package de.transio.hiuni.feature.mensa.review.data
+
+import androidx.room.Entity
+import androidx.room.PrimaryKey
+
+@Entity(tableName = "my_keys")
+data class MyKeyEntity(
+    @PrimaryKey val pubkey: String,
+    val secretKeyEncrypted: ByteArray,
+    val createdAt: Long,
+) {
+    override fun equals(other: Any?): Boolean {
+        if (this === other) return true
+        if (other !is MyKeyEntity) return false
+        return pubkey == other.pubkey &&
+            secretKeyEncrypted.contentEquals(other.secretKeyEncrypted) &&
+            createdAt == other.createdAt
+    }
+
+    override fun hashCode(): Int {
+        var result = pubkey.hashCode()
+        result = 31 * result + secretKeyEncrypted.contentHashCode()
+        result = 31 * result + createdAt.hashCode()
+        return result
+    }
+}
diff --git a/app/src/main/java/de/transio/hiuni/feature/mensa/review/data/NutritionParser.kt b/app/src/main/java/de/transio/hiuni/feature/mensa/review/data/NutritionParser.kt
