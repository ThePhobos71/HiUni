@@ -0,0 +1,110 @@
+package de.transio.hiuni.feature.mensa.review.trust
+
+import android.graphics.Bitmap
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.compose.foundation.Image
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.asImageBitmap
+import com.google.zxing.BarcodeFormat
+import com.google.zxing.qrcode.QRCodeWriter
+import com.journeyapps.barcodescanner.ScanContract
+import com.journeyapps.barcodescanner.ScanOptions
+
+/**
+ * Phase-7-Trust-Intro UI-Bausteine: QR-Anzeige des eigenen Pubkeys + Scan eines
+ * Peer-Pubkeys. Beide Composables liegen bewusst in derselben Datei, weil sie
+ * dasselbe Payload-Format teilen (`"hiuni-intro:<base64-pubkey>"`) und nur
+ * zusammen Sinn ergeben — der Eingeladene zeigt den QR, der Inviter scannt ihn.
+ *
+ * Format-Constraint: Der Prefix `hiuni-intro:` ist absichtlich gewählt, damit
+ * Scanner aus anderen Apps (Web-Login-QR, V-Cards, beliebige URLs) nicht
+ * versehentlich als Pubkey-Intro interpretiert werden.
+ */
+private const val INTRO_PREFIX = "hiuni-intro:"
+
+/**
+ * Rendert den eigenen Pubkey als QR-Code (512x512, ARGB monochrom).
+ *
+ * Wir verzichten bewusst auf eine Caching-Schicht: Der Pubkey ändert sich pro
+ * App-Installation nur einmal (nach Onboarding), und das Bitmap ist klein genug,
+ * dass `remember(pubkey)` reicht — ein erneuter Process-Death-Restart regeneriert
+ * es in <10ms.
+ */
+@Composable
+fun ShowMyPubkeyQr(pubkey: String, modifier: Modifier = Modifier) {
+    val bmp = remember(pubkey) { qrBitmap(INTRO_PREFIX + pubkey) }
+    Image(
+        bitmap = bmp.asImageBitmap(),
+        contentDescription = "Mein Pubkey-QR",
+        modifier = modifier,
+    )
+}
+
+/**
+ * Stellt einen Launcher für den zxing-Scanner bereit und liefert das gescannte
+ * Pubkey (ohne Prefix) via [onResult]. Aufruf-Pattern:
+ *
+ * ```
+ * val launch = rememberPubkeyScanLauncher(onResult = vm::introduce)
+ * Button(onClick = launch) { Text("Scannen") }
+ * ```
+ *
+ * Wir filtern strikt auf den `hiuni-intro:`-Prefix; alles andere (Wifi-QR, URLs,
+ * V-Cards, …) wird stillschweigend verworfen. Genauso `result == null` (User hat
+ * den Scanner abgebrochen).
+ */
+@Composable
+fun rememberPubkeyScanLauncher(onResult: (String) -> Unit): () -> Unit {
+    val launcher = rememberLauncherForActivityResult(ScanContract()) { result ->
+        val raw = result?.contents ?: return@rememberLauncherForActivityResult
+        if (raw.startsWith(INTRO_PREFIX)) {
+            onResult(raw.removePrefix(INTRO_PREFIX))
+        }
+    }
+    return {
+        val options = ScanOptions().apply {
+            setDesiredBarcodeFormats(ScanOptions.QR_CODE)
+            setPrompt("Pubkey-QR scannen")
+            setBeepEnabled(false)
+            setOrientationLocked(false)
+        }
+        launcher.launch(options)
+    }
+}
+
+/**
+ * Convenience-Wrapper: Button, der den Scanner öffnet und das Ergebnis an
+ * [onResult] weitergibt. Kann direkt in Profil-/QrIntro-Screen platziert werden.
+ */
+@Composable
+fun ScanPeerPubkeyQr(
+    onResult: (String) -> Unit,
+    modifier: Modifier = Modifier,
+    label: String = "Scannen",
+) {
+    val launch = rememberPubkeyScanLauncher(onResult)
+    androidx.compose.material3.Button(onClick = launch, modifier = modifier) {
+        androidx.compose.material3.Text(label)
+    }
+}
+
+/**
+ * Erzeugt ein QR-Bitmap aus [text]. RGB_565 reicht — das QR-Bitmap ist strikt
+ * 2-farbig und wir sparen so 50% gegenüber ARGB_8888. setPixel-Loop ist okay,
+ * weil 512x512 = 262k Pixel < 5ms auf Mid-Range-Geräten.
+ */
+private fun qrBitmap(text: String, size: Int = 512): Bitmap {
+    val matrix = QRCodeWriter().encode(text, BarcodeFormat.QR_CODE, size, size)
+    val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.RGB_565)
+    for (x in 0 until size) {
+        for (y in 0 until size) {
+            bmp.setPixel(
+                x, y,
+                if (matrix[x, y]) 0xFF000000.toInt() else 0xFFFFFFFF.toInt()
+            )
+        }
+    }
+    return bmp
+}
