+        assertArrayEquals(first.secretKey, second.secretKey)
+    }
+
+    @Test
+    fun `getOrNull returns null when nothing stored`() = runBlocking {
+        val mgr = MyKeyManager(FakeDao(), IdentityWrap())
+        assertNull(mgr.getOrNull())
+    }
+
+    @Test
+    fun `clear removes stored key`() = runBlocking {
+        val mgr = MyKeyManager(FakeDao(), IdentityWrap())
+        mgr.create()
+        assertNotNull(mgr.getOrNull())
+        mgr.clear()
+        assertNull(mgr.getOrNull())
+    }
+
+    @Test
+    fun `restore persists supplied pubkey and secret`() = runBlocking {
+        val dao = FakeDao()
+        val mgr = MyKeyManager(dao, IdentityWrap())
+        // create a real keypair, then restore using raw bytes
+        val original = mgr.create()
+        dao.entity = null // clear storage
+
+        mgr.restore(
+            pubkeyB64 = java.util.Base64.getEncoder().encodeToString(original.publicKey),
+            secretBytes = original.secretKey,
+        )
+        val restored = mgr.getOrNull()
+        assertNotNull(restored)
+        assertArrayEquals(original.publicKey, restored!!.publicKey)
+        assertArrayEquals(original.secretKey, restored.secretKey)
