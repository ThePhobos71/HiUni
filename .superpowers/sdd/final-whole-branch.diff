+++ b/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/AndroidKeystoreWrap.kt
@@ -0,0 +1,65 @@
+package de.transio.hiuni.feature.mensa.review.trust
+
+import android.security.keystore.KeyGenParameterSpec
+import android.security.keystore.KeyProperties
+import java.security.KeyStore
+import javax.crypto.Cipher
+import javax.crypto.KeyGenerator
+import javax.crypto.SecretKey
+import javax.crypto.spec.GCMParameterSpec
+import javax.inject.Inject
+
+/**
+ * Production [KeystoreWrap] backed by Android Keystore.
+ *
+ * Uses AES/GCM/NoPadding with a hardware-backed key alias [ALIAS].
+ * The 12-byte IV is prepended to the ciphertext on [wrap] and split off on [unwrap].
+ * The 128-bit authentication tag is appended by the GCM cipher automatically.
+ */
+class AndroidKeystoreWrap @Inject constructor() : KeystoreWrap {
+
+    private val keystore: KeyStore =
+        KeyStore.getInstance("AndroidKeyStore").apply { load(null) }
+
+    private fun getOrCreateKey(): SecretKey {
+        (keystore.getKey(ALIAS, null) as? SecretKey)?.let { return it }
+        val gen = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore")
+        gen.init(
+            KeyGenParameterSpec.Builder(
+                ALIAS,
+                KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT,
+            )
+                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                .setKeySize(256)
+                .build()
+        )
+        return gen.generateKey()
+    }
+
+    /** Encrypts [secret] and returns `iv (12 bytes) || ciphertext+tag`. */
+    override fun wrap(secret: ByteArray): ByteArray {
+        val cipher = Cipher.getInstance(TRANSFORMATION)
+        cipher.init(Cipher.ENCRYPT_MODE, getOrCreateKey())
+        val iv = cipher.iv          // GCM auto-generates a 12-byte IV
+        val ct = cipher.doFinal(secret)
+        return iv + ct              // 12 bytes IV + ciphertext (with 16-byte tag)
+    }
+
+    /** Decrypts data produced by [wrap]. Expects `iv (12 bytes) || ciphertext+tag`. */
+    override fun unwrap(wrapped: ByteArray): ByteArray {
+        require(wrapped.size > IV_LEN) { "Wrapped blob too short (${wrapped.size} bytes)" }
+        val iv = wrapped.copyOfRange(0, IV_LEN)
+        val ct = wrapped.copyOfRange(IV_LEN, wrapped.size)
+        val cipher = Cipher.getInstance(TRANSFORMATION)
+        cipher.init(Cipher.DECRYPT_MODE, getOrCreateKey(), GCMParameterSpec(TAG_LEN_BITS, iv))
+        return cipher.doFinal(ct)
+    }
+
+    private companion object {
+        const val ALIAS = "hiuni-review-key"
+        const val TRANSFORMATION = "AES/GCM/NoPadding"
+        const val IV_LEN = 12
+        const val TAG_LEN_BITS = 128
+    }
+}
