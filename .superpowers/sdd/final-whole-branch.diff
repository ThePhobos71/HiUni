+import kotlinx.serialization.EncodeDefault
+import kotlinx.serialization.ExperimentalSerializationApi
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+
+sealed interface SignedEvent {
+    val pubkey: String
+    val ts: Long
+    val sig: String
+    fun canonical(): String
+    fun eventId(): String = sha256(canonical()).toBase64()
+}
+
+// `type` ist ein reales serialisiertes Feld (kein computed getter), damit kotlinx-serialization
+// es ins JSON-Output schreibt. Outbox/queryAfter/Polymorpher-Ingest in RelayClient brauchen das
+// `type`-Feld zur Diskriminierung. Default-Wert garantiert stabilen Inhalt, Position 1 spiegelt
+// die canonical()-Reihenfolge.
+@Serializable
+@OptIn(ExperimentalSerializationApi::class)
+data class ReviewEvent(
+    @EncodeDefault val type: String = "review",
+    val schemaVersion: Int,
+    val recipeHash: String,
+    val overall: Int,
+    val wouldOrderAgain: Boolean,
+    val taste: Int?,
+    val portion: Int?,
+    val value: Int?,
+    val satiation: Int?,
+    override val ts: Long,
+    override val pubkey: String,
+    override val sig: String,
+) : SignedEvent {
+    override fun canonical(): String = listOf(
+        type, schemaVersion, recipeHash, overall, wouldOrderAgain,
+        taste, portion, value, satiation, ts, pubkey
+    ).joinToString("|") { it.canon() }
+}
+
+@Serializable
+@OptIn(ExperimentalSerializationApi::class)
+data class ValidationEvent(
+    @EncodeDefault val type: String = "validation",
+    @SerialName("pubkey") val pubkey_: String,   // carries the *introduced* pubkey, not the author
+    override val ts: Long,
+    val issuer: String,
+    override val sig: String,
+) : SignedEvent {
+    override val pubkey: String get() = pubkey_
+    override fun canonical(): String = listOf(type, pubkey_, ts, issuer).joinToString("|") { it.canon() }
+}
+
+@Serializable
+@OptIn(ExperimentalSerializationApi::class)
+data class IntroEvent(
+    @EncodeDefault val type: String = "intro",
+    val invitee: String,
+    val inviter: String,
+    override val ts: Long,
+    override val sig: String,
+) : SignedEvent {
+    override val pubkey: String get() = inviter
+    override fun canonical(): String = listOf(type, invitee, inviter, ts).joinToString("|") { it.canon() }
+}
+
+@Serializable
+@OptIn(ExperimentalSerializationApi::class)
+data class RetractionEvent(
+    @EncodeDefault val type: String = "retraction",
+    val targetEventId: String,
+    override val ts: Long,
+    override val pubkey: String,
+    override val sig: String,
+) : SignedEvent {
+    override fun canonical(): String =
+        listOf(type, targetEventId, ts, pubkey).joinToString("|") { it.canon() }
+}
