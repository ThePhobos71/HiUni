+package de.transio.hiuni.events
+
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.JsonElement
+
+/**
+ * Wire-Format zwischen App und Relay-Server.
+ *
+ * Polymorpher Sealed-Type mit JSON-Diskriminator `type`. Der innere signierte
+ * Event-Payload bleibt absichtlich als opaker [JsonElement] erhalten, damit das
+ * Wire-Format ohne Schema-Bruch um neue Event-Typen erweitert werden kann.
+ *
+ * Lebt in `:shared-events`, damit App-Client und Relay-Server identische
+ * Sealed-Class-Definition teilen — sonst hätten wir zwei Definitionen mit
+ * subtilen Drift-Risiken.
+ */
+@Serializable
+sealed class SyncFrame {
+    @Serializable
+    @SerialName("hello")
+    data class Hello(
+        val v: Int = 1,
+        val since: Long,
+        val sinceId: String? = null,
+    ) : SyncFrame()
+
+    @Serializable
+    @SerialName("event")
+    data class Event(val kind: String, val data: JsonElement) : SyncFrame()
+
+    @Serializable
+    @SerialName("events")
+    data class Events(
+        val items: List<JsonElement>,
+        val hasMore: Boolean,
+        val cursor: Long,
+        val cursorId: String? = null,
+    ) : SyncFrame()
+
+    @Serializable
+    @SerialName("ping")
+    data class Ping(val ts: Long) : SyncFrame()
+
+    @Serializable
+    @SerialName("pong")
+    data class Pong(val ts: Long) : SyncFrame()
+}
