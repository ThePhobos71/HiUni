index 0000000..802df2b
--- /dev/null
+++ b/app/src/main/java/de/transio/hiuni/feature/mensa/review/data/NutritionParser.kt
@@ -0,0 +1,74 @@
+package de.transio.hiuni.feature.mensa.review.data
+
+import de.transio.hiuni.events.Per100g
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.doubleOrNull
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+/**
+ * Parst den `nutritionalValuesJson`-Block aus [MealEntity] in einen [Per100g] für den
+ * Recipe-Hash. Akzeptiert zwei Formate:
+ *
+ * 1. **Persistiertes STW-Format** (flach, Werte als Roh-Strings):
+ *    `{"caloric_value": "586 kJ (140 kcal)", "fat": "3,7 g", "carbohydrates": "20 g", ...}`
+ * 2. **Hypothetisches nested-Format** (Werte als Zahlen) — falls jemals umgestellt:
+ *    `{"per_100_grams": {"caloric_value": 140.0, "fat": 3.7, ...}}`
+ *
+ * Aus String-Werten wird die erste Dezimalzahl extrahiert (Kommata als Dezimaltrenner) —
+ * für `caloric_value` priorisieren wir die kcal-Zahl in Klammern, da das Fingerprint
+ * sonst je nach kJ-Rundung der STW driftet.
+ *
+ * Gibt `null` zurück wenn `jsonStr` null/leer ist oder JSON komplett kaputt.
+ */
+private val json = Json { ignoreUnknownKeys = true }
+
+fun parseNutrition(jsonStr: String?): Per100g? {
+    if (jsonStr.isNullOrBlank()) return null
+    return runCatching {
+        val root = json.parseToJsonElement(jsonStr).jsonObject
+        // Nested-Variante falls je umgestellt
+        val per100 = (root["per_100_grams"] as? JsonObject) ?: root
+        Per100g(
+            caloricValue = extractKcal(per100, "caloric_value"),
+            fat = numericField(per100, "fat"),
+            carbohydrates = numericField(per100, "carbohydrates"),
+            protein = numericField(per100, "protein"),
+            salt = numericField(per100, "salt"),
+        ).takeIf {
+            // Wenn alles null ist, liefern wir lieber null — sonst hat
+            // nutritionFingerprint() denselben Effekt (gibt null), aber ein
+            // explizites null hier ist klarer.
+            listOf(it.caloricValue, it.fat, it.carbohydrates, it.protein, it.salt).any { v -> v != null }
+        }
+    }.getOrNull()
+}
+
+/** Liest ein Feld entweder als JSON-Number oder parst die erste Dezimalzahl aus dem String. */
+private fun numericField(obj: JsonObject, key: String): Double? {
+    val prim = obj[key]?.jsonPrimitive ?: return null
+    prim.doubleOrNull?.let { return it }
+    return prim.contentOrNull?.let { extractFirstDouble(it) }
+}
+
+/**
+ * Bevorzugt die Kalorien-Zahl in Klammern (`"586 kJ (140 kcal)"` → 140.0). Fällt
+ * auf null zurück wenn das Feld kein String mit `kcal`-Match ist (Caller probiert
+ * dann den generischen Pfad).
+ */
+private fun extractKcal(obj: JsonObject, key: String): Double? {
+    val raw = obj[key]?.jsonPrimitive?.contentOrNull ?: return null
+    return Regex("(\\d+(?:[.,]\\d+)?)\\s*kcal", RegexOption.IGNORE_CASE)
+        .find(raw)
+        ?.groupValues
+        ?.get(1)
+        ?.replace(',', '.')
+        ?.toDoubleOrNull()
+}
+
+private fun extractFirstDouble(s: String): Double? {
+    val m = Regex("-?\\d+(?:[.,]\\d+)?").find(s) ?: return null
+    return m.value.replace(',', '.').toDoubleOrNull()
+}
