+    }
+    @Test fun `tampered review fails verify`() {
+        val kp = Ed25519.generateKeypair()
+        val signed = ReviewEvent(schemaVersion = 1, recipeHash = "hash", overall = 4, wouldOrderAgain = true, taste = null, portion = null, value = null, satiation = null,
+            ts = 1L, pubkey = kp.publicKey.toBase64(), sig = "").signWith(kp)
+        val tampered = signed.copy(overall = 5)
+        assertFalse(tampered.verify())
+    }
+}
