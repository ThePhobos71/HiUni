+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.nio.file.Files
+
+@Serializable
+private data class ValidateResponseDto(
+    val validationEvent: ValidationEvent,
+    val relayMasterPubkey: String,
+)
+
+class ValidateEndpointTest {
+
+    private fun freshDb(): EventStore {
+        val tmp = Files.createTempFile("relay-validate", ".db").toFile().also { it.deleteOnExit() }
+        return EventStore(tmp.absolutePath).also { it.init() }
+    }
+
+    private fun freshMasterKey(): MasterKey {
+        val persist = Files.createTempFile("relay-master", ".key").toFile()
+            .also { it.delete(); it.deleteOnExit() }
+        return MasterKey(envB64 = null, persistPath = persist.absolutePath)
+    }
+
+    @Test
+    fun `validate happy path returns ValidationEvent with verifiable signature`() = runBlocking {
+        testApplication {
+            val store = freshDb()
+            val mk = freshMasterKey()
+            application {
+                installEventStore(store)
+                install(ContentNegotiation) { ktorJson(json) }
+                install(ServerWebSockets)
+                routing { health(); sync(); validate(mk, StubLsfBridge(), "test-secret") }
+            }
+            val client = createClient {
+                install(ClientContentNegotiation) { ktorJson(json) }
+            }
+            val resp = client.post("/validate") {
+                contentType(ContentType.Application.Json)
+                setBody(ValidateRequest("stub-12345", "pk-test"))
+            }
+            assertEquals(200, resp.status.value)
+            val body = resp.body<ValidateResponseDto>()
+            assertEquals("pk-test", body.validationEvent.pubkey_)
+            assertEquals("relay", body.validationEvent.issuer)
+            assertEquals(mk.pubkeyB64, body.relayMasterPubkey)
+            assertTrue(
+                "ValidationEvent sig must verify against returned relayMasterPubkey",
+                body.validationEvent.verify(body.relayMasterPubkey)
+            )
+        }
+    }
+
+    @Test
+    fun `validate rejects invalid LSF cookie with 401`() = runBlocking {
+        testApplication {
+            val store = freshDb()
+            val mk = freshMasterKey()
+            application {
+                installEventStore(store)
+                install(ContentNegotiation) { ktorJson(json) }
+                install(ServerWebSockets)
+                routing { health(); sync(); validate(mk, StubLsfBridge(), "test-secret") }
+            }
+            val client = createClient {
+                install(ClientContentNegotiation) { ktorJson(json) }
+            }
+            val resp = client.post("/validate") {
+                contentType(ContentType.Application.Json)
+                setBody(ValidateRequest("garbage-cookie", "pk-test"))
+            }
+            assertEquals(401, resp.status.value)
+        }
+    }
+
+    @Test
+    fun `validate replaces existing pubkey on phone switch (matrikel-hash collision)`() = runBlocking {
+        testApplication {
+            val store = freshDb()
+            val mk = freshMasterKey()
+            application {
+                installEventStore(store)
+                install(ContentNegotiation) { ktorJson(json) }
+                install(ServerWebSockets)
+                routing { health(); sync(); validate(mk, StubLsfBridge(), "test-secret") }
+            }
+            val client = createClient {
+                install(ClientContentNegotiation) { ktorJson(json) }
+            }
+            // first phone
+            val first = client.post("/validate") {
+                contentType(ContentType.Application.Json)
+                setBody(ValidateRequest("stub-77777", "pk-old"))
+            }
+            assertEquals(200, first.status.value)
+            // second phone, same Matrikel
+            val second = client.post("/validate") {
+                contentType(ContentType.Application.Json)
+                setBody(ValidateRequest("stub-77777", "pk-new"))
+            }
+            assertEquals(200, second.status.value)
+            // findMatNr should now point to pk-new (mat-hash row updated, old pubkey deprecated)
+            val matHash = hmacHex("test-secret", "77777")
+            assertEquals("pk-new", store.findMatNr(matHash))
+        }
+    }
+
+    @Test
+    fun `MasterKey persists to disk and reloads stable pubkey`() {
+        val persist = Files.createTempFile("relay-master-persist", ".key").toFile()
+            .also { it.delete(); it.deleteOnExit() }
+        val mk1 = MasterKey(envB64 = null, persistPath = persist.absolutePath)
+        val pub1 = mk1.pubkeyB64
+        val mk2 = MasterKey(envB64 = null, persistPath = persist.absolutePath)
+        assertEquals("Pubkey must be stable across MasterKey restarts", pub1, mk2.pubkeyB64)
+    }
+
+    @Test
+    fun `hmacHex is deterministic and hex-encoded`() {
+        val a = hmacHex("secret", "12345")
+        val b = hmacHex("secret", "12345")
+        assertEquals(a, b)
+        assertTrue("hex chars only", a.all { it in '0'..'9' || it in 'a'..'f' })
+        assertEquals("SHA-256 → 64 hex chars", 64, a.length)
+        assertFalse("different msg → different hash", a == hmacHex("secret", "12346"))
+    }
+
+    @Test
+    fun `StubLsfBridge accepts stub-prefixed cookies only`() = runBlocking {
+        val lsf = StubLsfBridge()
+        assertNotNull(lsf.whoami("stub-99"))
+        assertEquals("99", lsf.whoami("stub-99")?.matrikelnummer)
+        assertEquals(null, lsf.whoami("nope"))
+    }
+}
