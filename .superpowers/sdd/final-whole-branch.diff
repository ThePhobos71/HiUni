diff --git a/hiuni-relay/Dockerfile b/hiuni-relay/Dockerfile
new file mode 100644
index 0000000..4ba15ef
--- /dev/null
+++ b/hiuni-relay/Dockerfile
@@ -0,0 +1,40 @@
+FROM gradle:8.10-jdk21 AS build
+WORKDIR /app
+
+# Layer 1: Gradle-Settings + Version-Catalog → cached solange diese Dateien gleich bleiben.
+COPY settings.gradle.kts build.gradle.kts gradle.properties ./
+COPY gradle ./gradle
+
+# Layer 2: Modul-Build-Skripte (kein Source) → cached solange Dependencies sich nicht ändern.
+COPY shared-events/build.gradle.kts ./shared-events/
+COPY hiuni-relay/build.gradle.kts ./hiuni-relay/
+
+# Layer 3: Dependencies vorladen (mit BuildKit-Cache für ~/.gradle/caches).
+# `help` reicht aus, um alle deklarierten Configurations zu resolven.
+RUN --mount=type=cache,target=/home/gradle/.gradle/caches \
+    gradle --no-daemon :hiuni-relay:dependencies --quiet >/dev/null 2>&1 || true
+
+# Layer 4: Source — nur dieser Schritt wird bei Code-Änderungen neu gebaut.
+COPY shared-events/src ./shared-events/src
+COPY hiuni-relay/src ./hiuni-relay/src
+
+RUN --mount=type=cache,target=/home/gradle/.gradle/caches \
+    gradle :hiuni-relay:installDist --no-daemon \
+    && mkdir -p /empty-data \
+    && chown -R 65532:65532 /empty-data
+
+FROM gcr.io/distroless/java21-debian12:nonroot
+COPY --from=build /app/hiuni-relay/build/install/hiuni-relay /app
+# Pre-create /data owned by `nonroot` (uid 65532) so SQLite can write its DB.
+# With a docker-compose named volume, Docker carries this ownership on first init.
+COPY --from=build --chown=65532:65532 /empty-data /data
+WORKDIR /app
+ENV DB_PATH=/data/relay.db \
+    HMAC_SECRET="" \
+    MASTER_KEY_B64=""
+VOLUME /data
+EXPOSE 8080
+# Distroless has no shell, so the gradle-generated bin/hiuni-relay script can't run.
+# Distroless' default entrypoint is `java -jar`; override it to invoke our main class
+# off the classpath produced by installDist.
+ENTRYPOINT ["java", "-cp", "/app/lib/*", "de.transio.hiuni.relay.ApplicationKt"]
