+package de.transio.hiuni.feature.mensa.review.di
+
+import dagger.Module
+import dagger.Provides
+import dagger.hilt.InstallIn
+import dagger.hilt.components.SingletonComponent
+import de.transio.hiuni.BuildConfig
+import de.transio.hiuni.core.database.AppDatabase
+import de.transio.hiuni.feature.mensa.review.data.MutedPubkeyDao
+import de.transio.hiuni.feature.mensa.review.data.MyKeyDao
+import de.transio.hiuni.feature.mensa.review.data.OutboxDao
+import de.transio.hiuni.feature.mensa.review.data.PeerCursorDao
+import de.transio.hiuni.feature.mensa.review.data.ReviewDao
+import de.transio.hiuni.feature.mensa.review.data.TrustDao
+import de.transio.hiuni.feature.mensa.review.sync.RelayConfig
+import de.transio.hiuni.feature.mensa.review.trust.AndroidKeystoreWrap
+import de.transio.hiuni.feature.mensa.review.trust.KeystoreWrap
+import okhttp3.OkHttpClient
+import java.util.concurrent.TimeUnit
+import javax.inject.Qualifier
+import javax.inject.Singleton
+
+/**
+ * Qualifier für den dedizierten WebSocket-OkHttpClient des Relay-Sync.
+ *
+ * Der globale [OkHttpClient] hat keinen Ping-Intervall (typische HTTP-Calls
+ * brauchen das nicht); für den Long-Lived-WebSocket wollen wir aber
+ * `pingInterval(30s)`, damit NAT-Mappings am Mobilfunk-Provider nicht ablaufen.
+ */
+@Qualifier
+@Retention(AnnotationRetention.BINARY)
+annotation class RelayHttpClient
+
+@Module
+@InstallIn(SingletonComponent::class)
+object ReviewModule {
+
+    @Provides
+    fun reviewDao(db: AppDatabase): ReviewDao = db.reviewDao()
+
+    @Provides
+    fun trustDao(db: AppDatabase): TrustDao = db.trustDao()
+
+    @Provides
+    fun outboxDao(db: AppDatabase): OutboxDao = db.outboxDao()
+
+    @Provides
+    fun myKeyDao(db: AppDatabase): MyKeyDao = db.myKeyDao()
+
+    @Provides
+    fun peerCursorDao(db: AppDatabase): PeerCursorDao = db.peerCursorDao()
+
+    @Provides
+    fun mutedPubkeyDao(db: AppDatabase): MutedPubkeyDao = db.mutedPubkeyDao()
+
+    @Provides
+    @Singleton
+    fun keystoreWrap(impl: AndroidKeystoreWrap): KeystoreWrap = impl
+
+    /**
+     * Dedizierter OkHttpClient für den Relay-WebSocket. Eigene Instanz, damit
+     * der 30s-Ping-Intervall (Connection-Keepalive über NAT) keine anderen
+     * HTTP-Clients beeinflusst.
+     */
+    @Provides
+    @Singleton
+    @RelayHttpClient
+    fun relayOkHttp(): OkHttpClient = OkHttpClient.Builder()
+        .pingInterval(30, TimeUnit.SECONDS)
+        .build()
+
+    @Provides
+    @Singleton
+    fun relayConfig(): RelayConfig = RelayConfig(baseUrl = BuildConfig.RELAY_BASE_URL)
+}
