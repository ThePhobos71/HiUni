@@ -0,0 +1,48 @@
+package de.transio.hiuni.feature.mensa.review.sync
+
+import de.transio.hiuni.events.EventStore
+import de.transio.hiuni.events.EventValidator
+import de.transio.hiuni.events.TrustResolver
+import de.transio.hiuni.feature.mensa.review.data.ReviewDao
+import de.transio.hiuni.feature.mensa.review.data.TrustDao
+import kotlinx.coroutines.runBlocking
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Erzeugt frische [EventValidator]-Instanzen pro eingehendem Sync-Batch.
+ *
+ * Der Validator hält per Konstruktor den aktuell gecachten Master-Pubkey;
+ * dieser kann sich nach einem `/validate`-Call ändern, deshalb bauen wir den
+ * Validator nicht statisch.
+ *
+ * `runBlocking` ist hier zulässig: Die Suspending-DAO-Calls werden aus den
+ * synchronen `TrustResolver`-/`EventStore`-Methoden heraus aufgerufen, die
+ * vom Validator immer aus einem IO-Coroutine-Kontext kommen (siehe
+ * [RelayClient.scope]). Das blockiert also einen IO-Worker-Thread, keinen
+ * Main-Thread.
+ */
+@Singleton
+class ValidatorFactory @Inject constructor(
+    private val trustDao: TrustDao,
+    private val reviewDao: ReviewDao,
+    private val masterPubkeyProvider: MasterPubkeyProvider,
+) {
+    suspend fun create(): EventValidator {
+        val masterPubkey = masterPubkeyProvider.get()
+        return EventValidator(
+            trust = object : TrustResolver {
+                override fun depthOf(pubkey: String): Int? =
+                    runBlocking { trustDao.find(pubkey)?.depth }
+            },
+            store = object : EventStore {
+                override fun exists(eventId: String): Boolean =
+                    runBlocking { reviewDao.exists(eventId) }
+
+                override fun countSince(pubkey: String, sinceMs: Long): Int =
+                    runBlocking { reviewDao.countSince(pubkey, sinceMs) }
+            },
+            masterPubkey = masterPubkey,
+        )
+    }
+}
diff --git a/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/AndroidKeystoreWrap.kt b/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/AndroidKeystoreWrap.kt
