--- /dev/null
+++ b/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/Hmac.kt
@@ -0,0 +1,26 @@
+package de.transio.hiuni.relay
+
+import javax.crypto.Mac
+import javax.crypto.spec.SecretKeySpec
+
+/**
+ * HMAC-SHA256 von [msg] mit [secret], hex-kodiert (Lowercase, 64 Zeichen).
+ *
+ * Genutzt für Pseudonymisierung der LSF-Matrikelnummer: nur das Relay (das
+ * `HMAC_SECRET` kennt) kann ein `hmacHex(secret, matrikelnummer)` reproduzieren.
+ * Der Hash landet als opaker Schlüssel in `mat_nr_hashes`.
+ */
+fun hmacHex(secret: String, msg: String): String {
+    val mac = Mac.getInstance("HmacSHA256")
+    mac.init(SecretKeySpec(secret.toByteArray(Charsets.UTF_8), "HmacSHA256"))
+    val digest = mac.doFinal(msg.toByteArray(Charsets.UTF_8))
+    return buildString(digest.size * 2) {
+        for (b in digest) {
+            val v = b.toInt() and 0xff
+            append(HEX[v ushr 4])
+            append(HEX[v and 0x0f])
+        }
+    }
+}
+
+private val HEX = "0123456789abcdef".toCharArray()
diff --git a/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/LsfBridge.kt b/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/LsfBridge.kt
