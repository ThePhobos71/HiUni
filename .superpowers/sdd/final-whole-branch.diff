@@ -0,0 +1,30 @@
+package de.transio.hiuni.relay
+
+/**
+ * Bridge in das LSF-Identitätssystem der Universität.
+ *
+ * Nimmt ein vom Client mitgeliefertes Session-Cookie und gibt — falls die
+ * LSF-Session gültig ist — die zugehörige Matrikelnummer zurück. Wird vom
+ * `/validate`-Endpoint genau einmal pro Pubkey-Registrierung aufgerufen.
+ *
+ * Phase 3 nutzt [StubLsfBridge] für Tests. Die echte HTTP-Implementierung
+ * (`HiUniLsfBridge`) folgt in Phase 4-Production.
+ */
+interface LsfBridge {
+    suspend fun whoami(sessionCookie: String): LsfUser?
+}
+
+data class LsfUser(val matrikelnummer: String)
+
+/**
+ * Test-Stub: akzeptiert Cookies der Form `stub-<matrikelnummer>` und
+ * extrahiert die Matrikelnummer aus dem Suffix. Alles andere → null.
+ */
+class StubLsfBridge : LsfBridge {
+    override suspend fun whoami(sessionCookie: String): LsfUser? =
+        if (sessionCookie.startsWith("stub-")) {
+            LsfUser(matrikelnummer = sessionCookie.removePrefix("stub-"))
+        } else {
+            null
+        }
+}
diff --git a/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/MasterKey.kt b/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/MasterKey.kt
new file mode 100644
index 0000000..313918b
--- /dev/null
+++ b/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/MasterKey.kt
@@ -0,0 +1,105 @@
+package de.transio.hiuni.relay
+
+import de.transio.hiuni.events.Ed25519
+import de.transio.hiuni.events.Keypair
+import de.transio.hiuni.events.ValidationEvent
+import de.transio.hiuni.events.fromBase64
+import de.transio.hiuni.events.signWith
+import de.transio.hiuni.events.toBase64
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.io.File
+
+/**
+ * Persistentes Ed25519-Master-Keypair des Relays.
+ *
+ * Auflösungsreihenfolge:
+ * 1. Wenn [envB64] gesetzt ist → als Base64 des längen-prefix-Binärformats lesen.
+ * 2. Sonst: Datei [persistPath] lesen (falls vorhanden).
+ * 3. Sonst: neu generieren via [Ed25519.generateKeypair] und nach [persistPath] schreiben.
+ *
+ * **Wire-Format** (sowohl Datei als auch ENV-Base64-Entschlüsselung):
+ * `(pub.size:Int big-endian)(pub bytes)(sec bytes)` — Längen-Prefix nur für
+ * den Pubkey, weil Tink-Keysets variable Länge haben (Ed25519 ≈ 80 Bytes,
+ * pub ≈ 36 Bytes — kein fixer 32+64-Split wie bei raw libsodium).
+ *
+ * Phase-1+2-Whole-Branch-Review Finding #1: nicht in 32/64-Byte-Slices teilen,
+ * da Tink-Keyset-Blobs serialisiert werden.
+ */
+class MasterKey(
+    envB64: String?,
+    persistPath: String = "/data/master.key",
+) {
+    private val kp: Keypair = loadOrGenerate(envB64, persistPath)
+    val pubkeyB64: String = kp.publicKey.toBase64()
+
+    fun signValidation(pubkey: String, ts: Long): ValidationEvent =
+        ValidationEvent(pubkey_ = pubkey, ts = ts, issuer = "relay", sig = "")
+            .signWith(kp)
+
+    private fun loadOrGenerate(envB64: String?, persistPath: String): Keypair {
+        if (!envB64.isNullOrBlank()) {
+            return decode(envB64.fromBase64())
+        }
+        val f = File(persistPath)
+        if (f.exists() && f.length() > 0) {
+            return decode(f.readBytes())
+        }
+        val fresh = Ed25519.generateKeypair()
+        writeKeypairAtomically(f, fresh)
+        return fresh
+    }
+
+    /**
+     * I6-Fix: atomic-rename + chmod 600. Naiver `writeBytes` lässt bei Crash
+     * zwischen truncate und write eine Null-Byte-Datei zurück — der nächste
+     * Start würde dann ein frisches Keypair generieren und alle bereits vom
+     * Master signierten Pubkeys wären unverifizierbar.
+     */
+    private fun writeKeypairAtomically(f: File, kp: Keypair) {
+        val bytes = encode(kp)
+        f.parentFile?.mkdirs()
+        val tmp = File(f.parentFile, f.name + ".tmp")
+        tmp.writeBytes(bytes)
+        java.nio.file.Files.move(
+            tmp.toPath(),
+            f.toPath(),
+            java.nio.file.StandardCopyOption.ATOMIC_MOVE,
+            java.nio.file.StandardCopyOption.REPLACE_EXISTING,
+        )
+        // Owner-only: rw-------. Auf Non-POSIX-FS (Windows-Dev) silent no-op.
+        runCatching {
+            java.nio.file.Files.setPosixFilePermissions(
+                f.toPath(),
+                java.nio.file.attribute.PosixFilePermissions.fromString("rw-------"),
+            )
+        }
+    }
+
+    companion object {
+        /** `(pubSize:Int BE)(pub bytes)(sec bytes)` — Längen-Prefix nur für Pubkey. */
+        internal fun encode(kp: Keypair): ByteArray {
+            val out = ByteArrayOutputStream()
+            DataOutputStream(out).use { d ->
+                d.writeInt(kp.publicKey.size)
+                d.write(kp.publicKey)
+                d.write(kp.secretKey)
+            }
+            return out.toByteArray()
+        }
+
+        internal fun decode(bytes: ByteArray): Keypair {
+            DataInputStream(ByteArrayInputStream(bytes)).use { d ->
+                val pubSize = d.readInt()
+                require(pubSize in 1..(bytes.size - 4)) {
+                    "MasterKey decode: ungültige pubSize=$pubSize bei ${bytes.size} Bytes"
+                }
+                val pub = ByteArray(pubSize).also { d.readFully(it) }
+                val sec = d.readBytes()
+                return Keypair(publicKey = pub, secretKey = sec)
+            }
+        }
+    }
+}
diff --git a/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/Routes.kt b/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/Routes.kt
new file mode 100644
index 0000000..ede9d2e
--- /dev/null
+++ b/hiuni-relay/src/main/kotlin/de/transio/hiuni/relay/Routes.kt
@@ -0,0 +1,179 @@
+package de.transio.hiuni.relay
+
+import de.transio.hiuni.events.SyncFrame
+import io.ktor.http.HttpStatusCode
+import io.ktor.server.application.Application
+import io.ktor.server.application.call
+import io.ktor.server.request.receive
+import io.ktor.server.response.respond
+import io.ktor.server.routing.Routing
+import io.ktor.server.routing.get
+import io.ktor.server.routing.post
+import io.ktor.server.websocket.WebSocketServerSession
+import io.ktor.server.websocket.webSocket
+import io.ktor.util.AttributeKey
+import io.ktor.websocket.Frame
+import io.ktor.websocket.readText
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.slf4j.LoggerFactory
+import java.util.Collections
+
+private val log = LoggerFactory.getLogger("Routes")
+private const val SPAM_LIMIT_PER_DAY = 50
+
+internal data class Session(val ws: WebSocketServerSession)
+
+private val sessions: MutableSet<Session> = Collections.synchronizedSet(mutableSetOf())
+
+internal val json: Json = Json {
+    ignoreUnknownKeys = true
+    classDiscriminator = "type"
+}
+
+fun Routing.health() = get("/health") {
+    call.respond(
+        mapOf(
+            "events" to call.application.eventStore().totalCount(),
+            "connections" to sessions.size,
+        )
+    )
+}
+
+fun Routing.sync() = webSocket("/sync") {
+    val session = Session(this)
+    sessions.add(session)
+    val store = call.application.eventStore()
+    try {
+        for (frame in incoming) {
+            if (frame !is Frame.Text) continue
+            val parsed = json.decodeFromString<SyncFrame>(frame.readText())
+            when (parsed) {
+                is SyncFrame.Hello -> {
+                    val batch = store.queryAfter(parsed.since, 100, parsed.sinceId)
+                    val items = batch.items.map { json.parseToJsonElement(it) }
+                    send(
+                        Frame.Text(
+                            json.encodeToString<SyncFrame>(
+                                SyncFrame.Events(
+                                    items = items,
+                                    hasMore = batch.hasMore,
+                                    cursor = batch.cursor,
+                                    cursorId = batch.cursorId,
+                                )
+                            )
+                        )
+                    )
+                }
+                is SyncFrame.Event -> {
+                    val obj = parsed.data.jsonObject
+                    val kind = parsed.kind
+                    // TODO(task-19): relay-side eventId must be sha256(canonical(data)).toBase64()
+                    //  once we verify sig server-side. Current path trusts client-supplied id.
+                    //  See Phase 3 whole-branch review C2.
+                    val eventId = obj["eventId"]?.jsonPrimitive?.content
+                        ?: obj["sig"]?.jsonPrimitive?.content
+                        ?: continue
+                    val pubkey = obj["pubkey"]?.jsonPrimitive?.content ?: continue
+                    val ts = obj["ts"]?.jsonPrimitive?.content?.toLongOrNull() ?: continue
+                    val recent = store.countSince(pubkey, ts - 24L * 3600_000L)
+                    if (recent >= SPAM_LIMIT_PER_DAY) {
+                        log.warn("Spam-Guard: pubkey={} hat {} Events in 24h — drop", pubkey, recent)
+                        continue
+                    }
+                    if (!store.exists(eventId)) {
+                        store.insert(eventId, kind, pubkey, ts, parsed.data.toString())
+                        broadcastExcept(session, parsed)
+                    }
+                }
+                is SyncFrame.Ping -> send(
+                    Frame.Text(json.encodeToString<SyncFrame>(SyncFrame.Pong(parsed.ts)))
+                )
+                else -> {}
+            }
+        }
+    } finally {
+        sessions.remove(session)
+    }
+}
+
+private suspend fun broadcastExcept(except: Session, ev: SyncFrame.Event) {
+    val text = json.encodeToString<SyncFrame>(ev)
+    sessions.toList().filter { it !== except }.forEach {
+        runCatching { it.ws.send(Frame.Text(text)) }
+    }
+}
+
+private suspend fun broadcastAll(ev: SyncFrame.Event) {
+    val text = json.encodeToString<SyncFrame>(ev)
+    sessions.toList().forEach {
+        runCatching { it.ws.send(Frame.Text(text)) }
+    }
+}
+
+@Serializable
+data class ValidateRequest(val lsfSessionCookie: String, val pubkey: String)
+
+/**
+ * POST `/validate` — tauscht ein LSF-Session-Cookie gegen ein vom Relay
+ * signiertes `ValidationEvent` für die mitgegebene App-Pubkey.
+ *
+ * Flow:
+ *  1. [LsfBridge.whoami] → 401 wenn ungültig
+ *  2. `matHash = hmacHex(secret, matrikel)` — pseudonymisierte Matrikelnummer
+ *  3. EventStore.findMatNr: bestehender Pubkey für diese Matrikel?
+ *  4. wenn vorhanden und != neu → alten Pubkey deprecaten (Phone-Wechsel)
+ *  5. [MasterKey.signValidation] → ValidationEvent
+ *  6. EventStore: insert + upsertMatNr + registerPubkey (atomar genug für Phase 3)
+ *  7. Broadcast als `SyncFrame.Event(kind="validation")` an alle Sessions
+ *  8. Respond `{ validationEvent, relayMasterPubkey }`
+ */
+fun Routing.validate(masterKey: MasterKey, lsf: LsfBridge, hmacSecret: String) =
+    post("/validate") {
+        val req = call.receive<ValidateRequest>()
+        val store = call.application.eventStore()
+
+        val user = lsf.whoami(req.lsfSessionCookie)
+        if (user == null) {
+            call.respond(HttpStatusCode.Unauthorized)
+            return@post
+        }
+
+        val matHash = hmacHex(hmacSecret, user.matrikelnummer)
+        val existing = store.findMatNr(matHash)
+        if (existing != null && existing != req.pubkey) {
+            log.info("Phone-Switch: matHash={} deprecating={} new={}", matHash, existing, req.pubkey)
+            store.deprecateOldPubkey(existing)
+        }
+
+        val ts = System.currentTimeMillis()
+        val ev = masterKey.signValidation(req.pubkey, ts)
+        val payload = json.encodeToString(ev)
+        store.insert(ev.eventId(), "validation", req.pubkey, ts, payload)
+        store.upsertMatNr(matHash, req.pubkey)
+        store.registerPubkey(req.pubkey, ev.eventId())
+
+        // Broadcast via SyncFrame.Event(kind="validation") an alle Sessions —
+        // App-Clients erkennen das Event über `kind`.
+        val frame = SyncFrame.Event(kind = "validation", data = json.parseToJsonElement(payload))
+        broadcastAll(frame)
+
+        call.respond(ValidateResponse(validationEvent = ev, relayMasterPubkey = masterKey.pubkeyB64))
+    }
+
+@Serializable
+data class ValidateResponse(
+    val validationEvent: de.transio.hiuni.events.ValidationEvent,
+    val relayMasterPubkey: String,
+)
+
+private val EVENT_STORE_KEY = AttributeKey<EventStore>("eventStore")
+
+fun Application.installEventStore(store: EventStore) {
+    attributes.put(EVENT_STORE_KEY, store)
+}
+
+fun Application.eventStore(): EventStore = attributes[EVENT_STORE_KEY]
