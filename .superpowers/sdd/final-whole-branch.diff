+++ b/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/LsfOnboarding.kt
@@ -0,0 +1,236 @@
+package de.transio.hiuni.feature.mensa.review.trust
+
+import de.transio.hiuni.core.auth.CasCookieStore
+import de.transio.hiuni.core.auth.CasSession
+import de.transio.hiuni.di.IoDispatcher
+import de.transio.hiuni.events.BackupBlob
+import de.transio.hiuni.events.ValidationEvent
+import de.transio.hiuni.events.verify
+import de.transio.hiuni.feature.lsf.data.LsfClient
+import de.transio.hiuni.feature.mensa.review.data.TrustDao
+import de.transio.hiuni.feature.mensa.review.data.TrustEntity
+import de.transio.hiuni.feature.mensa.review.sync.MasterPubkeyProvider
+import de.transio.hiuni.feature.mensa.review.sync.RelayClient
+import de.transio.hiuni.feature.mensa.review.sync.RelayConfig
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import okhttp3.Cookie
+import okhttp3.CookieJar
+import okhttp3.HttpUrl
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import timber.log.Timber
+import java.util.Base64
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Recovery-Fehler: die vom User eingegebene Backup-PIN konnte das Mail-Backup
+ * nicht entschlüsseln. ViewModel zählt Versuche lokal hoch.
+ */
+class WrongPinException : Exception("backup pin invalid")
+
+/**
+ * Recovery-Fehler: Key konnte zwar wiederhergestellt werden, aber dieses Device
+ * kennt den Relay-Master-Pubkey nicht — d.h. wir können keine eingehenden
+ * `ValidationEvent`s verifizieren. Der User muss das LSF-Onboarding einmal
+ * durchlaufen, damit der Master persistiert wird.
+ */
+class MasterPubkeyMissingException : Exception("master pubkey missing after recovery")
+
+/**
+ * Onboarding-Flow: tauscht eine bestehende LSF-Session (JSESSIONID) gegen ein
+ * vom Relay signiertes [ValidationEvent], persistiert es als Self-Trust und
+ * merkt sich den Master-Pubkey für nachfolgende Signatur-Checks.
+ *
+ * Voraussetzung: gültige CAS-Session — wir holen damit ein Service-Ticket
+ * gegen die LSF-Bootstrap-URL und extrahieren die JSESSIONID aus dem Cookie-Jar.
+ * Diese wird als `lsfSessionCookie` an das Relay-`/validate` weitergereicht.
+ *
+ * Sicherheits-Invariante: Wir trusten nur, wenn `validationEvent.verify(master)`
+ * grünes Licht gibt — sonst rejected loud + MasterPubkey wird NICHT persistiert.
+ */
+@Singleton
+class LsfOnboarding @Inject constructor(
+    private val http: OkHttpClient,
+    private val cfg: RelayConfig,
+    private val keys: MyKeyManager,
+    private val trustDao: TrustDao,
+    private val masterPubkeyProvider: MasterPubkeyProvider,
+    private val casSession: CasSession,
+    private val cookieStore: CasCookieStore,
+    private val relayClient: RelayClient,
+    private val mailBackup: MailBackup,
+    @IoDispatcher private val io: CoroutineDispatcher,
+) {
+
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /**
+     * Recovery-Probe: schaut, ob im Mail-Drafts-Folder ein Backup liegt. Wirft
+     * NICHT, falls Mail-Login fehlt oder IMAP-Probleme — gibt dann einfach `null`
+     * zurück, damit der Caller (ViewModel) sauber auf "kein Backup, normaler
+     * LSF-Flow" zurückfallen kann.
+     */
+    suspend fun tryMailBackupOrNull(): BackupBlob? =
+        runCatching { mailBackup.findBackup() }.getOrNull()
+
+    /**
+     * Stellt den Keypair aus einem Mail-Backup wieder her und re-validiert,
+     * dass auf diesem Gerät auch ein Master-Pubkey vorliegt. Fehlt der Master
+     * (anderes Device hat onboardet, dieses Device hat den Pubkey noch nie
+     * persistiert), reicht das Backup allein nicht — der User muss zusätzlich
+     * den LSF-Roundtrip machen, damit Eingangs-Events verifiziert werden können.
+     *
+     * Rückgaben:
+     *  - [Result.success] → Recovery komplett, Caller kann RelayClient starten.
+     *  - failure mit [WrongPinException] → PIN falsch (bei erschöpften Versuchen
+     *    UI-seitig in Hard-Reset überleiten).
+     *  - failure mit [MasterPubkeyMissingException] → Key restored, aber Master
+     *    fehlt → UI auf normalen NeedsOnboarding-Pfad lenken.
+     */
+    suspend fun completeRecovery(blob: BackupBlob, pin: String): Result<Unit> = withContext(io) {
+        runCatching {
+            val ok = mailBackup.restoreFromBackup(blob, pin)
+            if (!ok) throw WrongPinException()
+            val master = masterPubkeyProvider.get()
+            if (master.isBlank()) {
+                Timber.w("Recovery: Key restored, aber MasterPubkey fehlt — LSF-Onboarding erforderlich")
+                throw MasterPubkeyMissingException()
+            }
+            Timber.i("Recovery komplett: pub=${blob.pubkey.take(8)}… master=${master.take(8)}…")
+            Unit
+        }
+    }
+
+    /**
+     * Volle Onboarding-Pipeline ohne extern bereitgestelltes Cookie — holt die
+     * LSF-Session selbst via CAS-ST und ruft dann [startOnboarding] mit dem
+     * extrahierten JSESSIONID auf.
+     */
+    suspend fun startOnboarding(): Result<Unit> = runCatching {
+        val cookie = withContext(io) { fetchLsfSessionCookie() }
+        startOnboarding(cookie).getOrThrow()
+    }
+
+    /**
+     * Stub-/Test-Hook: erlaubt es, einen bereits anderswo besorgten Cookie-String
+     * (z.B. `stub-<matrikel>` für die StubLsfBridge in Phase 3) direkt
+     * einzuspeisen. Produktivpfad nutzt [startOnboarding] ohne Argumente.
+     */
+    suspend fun startOnboarding(lsfSessionCookie: String): Result<Unit> = withContext(io) {
+        runCatching {
+            val kp = keys.getOrNull() ?: keys.create()
+            val pub = Base64.getEncoder().encodeToString(kp.publicKey)
+            val reqBody = json.encodeToString(ValidateRequest(lsfSessionCookie, pub))
+
+            val baseHttp = cfg.baseUrl
+                .replace("ws://", "http://")
+                .replace("wss://", "https://")
+            val req = Request.Builder()
+                .url("$baseHttp/validate")
+                .post(reqBody.toRequestBody("application/json".toMediaType()))
+                .build()
+
+            http.newCall(req).execute().use { resp ->
+                if (!resp.isSuccessful) {
+                    error("validate failed: HTTP ${resp.code}")
+                }
+                val parsed = json.decodeFromString<ValidateResponse>(
+                    resp.body?.string() ?: error("empty body")
+                )
+                // KRITISCH: bevor wir den Master-Pubkey adoptieren und Trust persistieren,
+                // muss die Master-Signatur über das eingebettete ValidationEvent stimmen.
+                // Ohne diesen Check könnte ein MITM uns einen beliebigen Pubkey als
+                // "Relay-Master" unterschieben — und ab dann alle Events validieren.
+                if (!parsed.validationEvent.verify(parsed.relayMasterPubkey)) {
+                    error("master signature invalid — refusing to trust")
+                }
+                trustDao.insert(
+                    TrustEntity(
+                        pubkey = pub,
+                        source = "relay",
+                        depth = 0,
+                        ts = parsed.validationEvent.ts,
+                        sig = parsed.validationEvent.sig,
+                    )
+                )
+                masterPubkeyProvider.set(parsed.relayMasterPubkey)
+                Timber.i("LSF-Onboarding ok: pub=${pub.take(8)}… master=${parsed.relayMasterPubkey.take(8)}…")
+                // C1-Fix: First-Session-Boot — Application.onCreate hat den
+                // RelayClient noch nicht gestartet (kein Master beim Boot). Jetzt,
+                // wo Master persistiert ist, WS hochfahren. start() ist idempotent.
+                runCatching { relayClient.start() }
+                    .onFailure { Timber.w(it, "RelayClient.start() nach Onboarding fehlgeschlagen") }
+                Unit
+            }
+        }
+    }
+
+    /**
+     * Holt einen frischen JSESSIONID-Cookie für die LSF-Session, indem ein ST
+     * gegen die LSF-Bootstrap-URL eingelöst wird. Die JSESSIONID landet im
+     * lokalen Cookie-Jar und wird im Header-Format `JSESSIONID=…` ans Relay
+     * weitergereicht.
+     */
+    private suspend fun fetchLsfSessionCookie(): String {
+        val ticket = casSession.getServiceTicket(LsfClient.LSF_LOGIN_SERVICE)
+        val ua = cookieStore.userAgent()
+        val jar = LsfHostCookieJar(LSF_HOST)
+        val client = http.newBuilder()
+            .followRedirects(true)
+            .cookieJar(jar)
+            .build()
+
+        val builder = Request.Builder()
+            .url("${LsfClient.LSF_LOGIN_SERVICE}&ticket=$ticket")
+            .header("Accept", "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8")
+        if (!ua.isNullOrBlank()) builder.header("User-Agent", ua)
+
+        client.newCall(builder.build()).execute().close()
+
+        val cookies = jar.snapshot()
+        val cookieHeader = cookies.joinToString("; ") { "${it.name}=${it.value}" }
+            .ifBlank { error("LSF lieferte keine Session-Cookies — Bootstrap fehlgeschlagen") }
+        Timber.d("LSF-Onboarding fetched cookie len=${cookieHeader.length} (#cookies=${cookies.size})")
+        return cookieHeader
+    }
+
+    @Serializable
+    private data class ValidateRequest(val lsfSessionCookie: String, val pubkey: String)
+
+    @Serializable
+    private data class ValidateResponse(
+        val validationEvent: ValidationEvent,
+        val relayMasterPubkey: String,
+    )
+
+    /**
+     * Hosted-scoped Cookie-Jar — verhindert Cross-Host-Leaks und gibt uns einen
+     * deterministischen Snapshot nach dem Bootstrap-Call.
+     */
+    private class LsfHostCookieJar(private val host: String) : CookieJar {
+        private val cookies = mutableListOf<Cookie>()
+        override fun saveFromResponse(url: HttpUrl, cookies: List<Cookie>) {
+            if (url.host != host) return
+            synchronized(this.cookies) {
+                this.cookies.removeAll { existing -> cookies.any { it.name == existing.name } }
+                this.cookies.addAll(cookies)
+            }
+        }
+        override fun loadForRequest(url: HttpUrl): List<Cookie> {
+            if (url.host != host) return emptyList()
+            return synchronized(this.cookies) { this.cookies.toList() }
+        }
+        fun snapshot(): List<Cookie> = synchronized(cookies) { cookies.toList() }
+    }
+
+    companion object {
+        private const val LSF_HOST = "lsf.uni-hildesheim.de"
+    }
+}
diff --git a/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MailBackup.kt b/app/src/main/java/de/transio/hiuni/feature/mensa/review/trust/MailBackup.kt
