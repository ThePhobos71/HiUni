# API-Key, den die App im Header "X-Api-Key" mitschicken muss.
# Erzeugen z.B. mit: openssl rand -hex 32
# Hinweis: Der Key steckt auch in der APK (BuildConfig) und ist damit faktisch
# öffentlich, siehe README (Abschnitt Sicherheitshinweise).
API_KEY=

# Wie oft (in Minuten) allen registrierten Geräten eine Tickle-Nachricht
# geschickt wird.
TICKLE_INTERVAL_MINUTES=15

# Typ der Data-Message. "sync_tickle" (Default): neue Apps machen Mail-Refresh
# + gestaffelten Feature-Prefetch. "mail_tickle": alte Apps machen nur Mail,
# bei Bestands-Deploys mit älteren Clients ggf. TICKLE_TYPE=mail_tickle setzen.
TICKLE_TYPE=sync_tickle

# Ruhezeit, in der keine Tickles verschickt werden (Format "HH:MM-HH:MM", darf
# über Mitternacht gehen). Stale-Tokens werden trotzdem aufgeräumt.
# Leer lassen (QUIET_HOURS=) deaktiviert die Ruhezeit. Ungültige Werte lassen
# den Server beim Start mit klarer Fehlermeldung abbrechen.
QUIET_HOURS=23:00-06:00

# Zeitzone für QUIET_HOURS (IANA-Name).
TIMEZONE=Europe/Berlin

# Firebase-Credentials, EINE der beiden Varianten setzen:
#
# Variante A (Coolify/PaaS ohne Datei-Mounts): kompletter Inhalt des
# Service-Account-JSON als mehrzeilige Env-Variable. Hat Vorrang vor Variante B.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type": "service_account", ...}
#
# Variante B (docker-compose/systemd): Pfad zum gemounteten Service-Account-JSON
# INNERHALB des Containers, passend zum Mount in docker-compose.yml.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/service-account.json

# Pfad zur SQLite-Datenbankdatei INNERHALB des Containers (liegt auf dem
# Volume unter /data, siehe docker-compose.yml bzw. Coolify Persistent Volume).
DB_PATH=/data/tokens.db

# Tokens mit last_seen älter als so viele Tage werden im Tickle-Loop entfernt.
# Die App re-registriert sich bei jedem Start (und bei FCM-Token-Rotate)
# idempotent, daher fängt der Default (60) nur wirklich tote Geräte ab.
# 0 = Purging aus.
TOKEN_MAX_AGE_DAYS=60

# Rate-Limit für /register + /unregister je Client-IP (Requests/Minute,
# Token-Bucket). 0 = Rate-Limit aus.
RATE_LIMIT_PER_MINUTE=10

# Maximale Anzahl gespeicherter Tokens. Ist die Tabelle voll, bekommt ein NEUES
# Token bei /register HTTP 503 (die App versucht es später erneut); bekannte
# Tokens dürfen sich immer re-registrieren. 0 = unbegrenzt.
MAX_TOKENS=5000
