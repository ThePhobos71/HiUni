# Geheimer API-Key, den die App im Header "X-Api-Key" mitschicken muss.
# Erzeugen z.B. mit: openssl rand -hex 32
API_KEY=

# Wie oft (in Minuten) allen registrierten Geräten eine Tickle-Nachricht
# geschickt wird.
TICKLE_INTERVAL_MINUTES=15

# Firebase-Credentials — EINE der beiden Varianten setzen:
#
# Variante A (Coolify/PaaS ohne Datei-Mounts): kompletter Inhalt des
# Service-Account-JSON als mehrzeilige Env-Variable. Hat Vorrang vor Variante B.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type": "service_account", ...}
#
# Variante B (docker-compose/systemd): Pfad zum gemounteten Service-Account-JSON
# INNERHALB des Containers, passend zum Mount in docker-compose.yml.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/service-account.json

# Pfad zur SQLite-Datenbankdatei INNERHALB des Containers (liegt auf dem
# tickle-data-Volume, siehe docker-compose.yml).
DB_PATH=/data/tokens.db
